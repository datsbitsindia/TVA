    html.dark-theme .cibil-lb-chip .cibil-lb-score,
    html.gray-glass-theme .cibil-lb-chip .cibil-lb-score {
        color: var(--tier-color) !important;
    }
    #reliability-modal #rm-score-val,
    #reliability-modal #rm-tier-badge,
    #reliability-modal #rm-ontime-impact,
