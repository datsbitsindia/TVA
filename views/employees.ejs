        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        color: #92400e;
    }
    .cibil-lb-title small {
        font-weight: 600;
        opacity: 0.75;
        font-size: 11px;
    }
    .cibil-lb-items {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .cibil-lb-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
