<aside class="sidebar">
    <div class="brand" style="padding: 14px 10px 18px 10px; display: flex; align-items: center; justify-content: center; background: transparent !important; border: none !important; box-shadow: none !important;">
        <img src="/icons/tva-logo.png" alt="TVA Logo" class="brand-logo" style="height: auto; max-height: 110px; width: 100%; max-width: 220px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.06)); background: transparent !important;">
    </div>
    <nav>
        <% if (user.role === 'manager') { %>
            <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge"></i>Dashboard
            </a>
        <% } %>

        <% if (user.role === 'admin') { %>
            <a href="/projects" class="<%= page === 'projects' ? 'active' : '' %>">
                <i class="fa-solid fa-folder-open"></i>Projects
            </a>
        <% } %>

        <% if (user.role !== 'admin') { %>
            <a href="/tasks" class="<%= page === 'tasks' ? 'active' : '' %>">
                <i class="fa-solid fa-check-double"></i>Tasks
            </a>
        <% } %>

        <% if (user.role === 'manager' || user.role === 'admin') { %>
            <a href="/employees" class="<%= page === 'employees' || page === 'managers' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i>Teams
            </a>
        <% } %>




        <% if (user.role === 'admin') { %>
            <a href="/updates" class="<%= page === 'updates' ? 'active' : '' %>">
                <i class="fa-solid fa-list-check"></i>Updates
            </a>
        <% } %>

        <a href="/notifications" class="<%= page === 'notifications' ? 'active' : '' %>" style="position:relative;">
            <i class="fa-solid fa-bell"></i>Notifications
            <b class="badge" style="<%= (typeof unread !== 'undefined' && unread > 0) ? 'display:inline-block;' : 'display:none;' %>"><%= (typeof unread !== 'undefined' && unread > 0) ? unread : '' %></b>
        </a>

        <a href="/notes" class="<%= page === 'notes' ? 'active' : '' %>">
            <i class="fa-solid fa-note-sticky"></i>Notes
        </a>

        <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i class="fa-solid fa-user"></i>Profile
        </a>
    </nav>
</aside>

<section class="main">
    <header class="topbar">
        <button class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-user-area" style="display: flex; align-items: center; gap: 10px; margin-right: auto;">
            <div class="topbar-user" style="margin-right: 0;">
                <strong><%= user.name %></strong>
                <small><%= user.role %><% if (typeof currentOrg !== 'undefined' && currentOrg && currentOrg.name) { %> · <%= currentOrg.name %><% } %></small>
            </div>

            <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" title="Toggle Light/Dark Theme" aria-label="Toggle Theme">
                <i class="fa-solid fa-moon moon-icon"></i>
                <i class="fa-regular fa-sun sun-icon"></i>
            </button>
        </div>

        <div class="topbar-right-group" style="display:flex; align-items:center; gap:8px;">
            <% if (page === 'tasks') { %>
                <button class="btn primary btn-sm" data-open="task-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> Add Task
                </button>
            <% } %>


            <% if (page === 'employees') { %>
                <button class="btn primary btn-sm" data-open="employee-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-user-plus"></i> Add Team Member
                </button>
            <% } %>

            <% if (page === 'projects' && user.role === 'admin') { %>
                <button class="btn primary btn-sm" data-open="project-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> New Project
                </button>
            <% } %>

            <form action="/logout" method="post" style="margin:0;">
                <button class="logout-btn" style="white-space:nowrap;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
            </form>
        </div>
    </header>

    <main class="content">
