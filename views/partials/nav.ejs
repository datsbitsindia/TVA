<aside class="sidebar">
    <div class="brand" style="padding: 14px 10px 18px 10px; display: flex; align-items: center; justify-content: center; background: transparent !important; border: none !important; box-shadow: none !important;">
        <img src="/icons/tva-logo-light.png" alt="TVA Logo" class="brand-logo brand-logo-light" style="height: auto; max-height: 110px; width: 100%; max-width: 220px; object-fit: contain; filter: drop-shadow(0 2px 10px rgba(0,0,0,0.25)); background: transparent !important;">
        <img src="/icons/tva-logo.png" alt="TVA Logo" class="brand-logo brand-logo-dark" style="height: auto; max-height: 110px; width: 100%; max-width: 220px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.06)); background: transparent !important; display: none;">
    </div>
    <nav>
        <% if (user.role === 'manager') { %>
            <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge"></i>Dashboard
            </a>
        <% } %>

        <% if (user.role === 'admin') { %>
            <a href="/projects" class="<%= page === 'projects' ? 'active' : '' %>">
                <i class="fa-solid fa-folder-open"></i>Projects
            </a>
        <% } %>

        <% if (user.role !== 'admin') { %>
            <a href="/tasks" class="<%= page === 'tasks' ? 'active' : '' %>">
                <i class="fa-solid fa-check-double"></i>Tasks
            </a>
        <% } %>

        <% if (user.role === 'manager' || user.role === 'admin') { %>
            <a href="/employees" class="<%= page === 'employees' || page === 'managers' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i>Teams
            </a>
        <% } %>




        <% if (user.role === 'admin') { %>
            <a href="/updates" class="<%= page === 'updates' ? 'active' : '' %>">
                <i class="fa-solid fa-list-check"></i>Updates
            </a>
        <% } %>

        <a href="/notifications" class="<%= page === 'notifications' ? 'active' : '' %>" style="position:relative;">
            <i class="fa-solid fa-bell"></i>Notifications
            <b class="badge" style="<%= (typeof unread !== 'undefined' && unread > 0) ? 'display:inline-block;' : 'display:none;' %>"><%= (typeof unread !== 'undefined' && unread > 0) ? unread : '' %></b>
        </a>

        <a href="/notes" class="<%= page === 'notes' ? 'active' : '' %>">
            <i class="fa-solid fa-note-sticky"></i>Notes
        </a>

        <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i class="fa-solid fa-user"></i>Profile
        </a>


    </nav>
</aside>

<section class="main">
    <% if (typeof impersonatingOrg !== 'undefined' && impersonatingOrg) { %>
        <div style="background: linear-gradient(90deg, #1e3a8a, #2563eb); color: white; padding: 10px 20px; font-size: 13.5px; font-weight: 600; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-user-ninja" style="color: #93c5fd;"></i>
                <span>Super Admin Mode: Viewing Organization <strong><%= impersonatingOrg.name %></strong></span>
            </div>
            <a href="/superadmin" style="background: rgba(255,255,255,0.22); color: white; padding: 4px 12px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 700; transition: background 0.15s;">
                <i class="fa-solid fa-arrow-left"></i> Exit to Super Admin Panel
            </a>
        </div>
    <% } %>

    <header class="topbar">
        <button class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-user-area" style="display: flex; align-items: center; gap: 10px; margin-right: auto;">
            <!-- Chrome / Google Profiles Switcher (Interactive) -->
            <div class="tva-profile-picker">
                <button type="button" id="tvaProfileBtn" class="tva-profile-pill" title="Switch Account / Profile">
                    <div class="tva-profile-avatar">
                        <%= (user.name || 'U').charAt(0) %>
                    </div>
                    <div class="tva-profile-summary">
                        <div class="tva-profile-summary-name"><%= user.name %></div>
                        <div class="tva-profile-summary-role"><%= user.role %></div>
                    </div>
                    <i class="fa-solid fa-chevron-down tva-profile-arrow"></i>
                </button>

                <!-- Chrome Profile Popup Menu (Matching user photo) -->
                <div id="tvaProfileMenu" class="tva-profile-popup" style="display:none;">
                    <!-- Active User Card -->
                    <div class="tva-profile-active-card">
                        <div class="tva-profile-active-avatar">
                            <%= (user.name || 'U').charAt(0) %>
                        </div>
                        <div class="tva-profile-active-info">
                            <div class="tva-profile-active-name"><%= user.name %></div>
                            <div class="tva-profile-active-email"><%= user.email %></div>
                            <div class="tva-profile-active-org"><%= (typeof currentOrg !== 'undefined' && currentOrg && currentOrg.name) ? currentOrg.name : 'Workspace' %> · <%= user.role %></div>
                        </div>
                        <span class="tva-profile-active-badge">Active</span>
                    </div>

                    <!-- Other Chrome profiles Style Header -->
                    <div class="tva-profile-section">
                        <div class="tva-profile-section-hdr">
                            <span>Other Profiles</span>
                            <span id="tvaProfilesCount" class="tva-profile-count"></span>
                        </div>
                        <div id="tvaOtherProfilesContainer" class="tva-profile-list">
                            <!-- Populated dynamically via JS from localStorage -->
                        </div>
                    </div>

                    <!-- Add Another Account Button -->
                    <div class="tva-profile-action-group">
                        <button type="button" class="tva-profile-add-btn" onclick="openAddAccountModal()">
                            <i class="fa-solid fa-user-plus"></i>
                            <span>Add another account</span>
                        </button>
                    </div>

                    <!-- Super Admin Link (if applicable) -->
                    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                        <div class="tva-profile-action-group">
                            <a href="/superadmin" class="tva-profile-superadmin-link">
                                <i class="fa-solid fa-crown"></i>
                                <span>Super Admin Platform</span>
                            </a>
                        </div>
                    <% } %>

                    <!-- Sign Out Options -->
                    <div class="tva-profile-signout-row">
                        <form action="/logout" method="post" style="margin:0;">
                            <button type="submit" class="tva-profile-signout-btn">
                                <i class="fa-solid fa-right-from-bracket"></i> Sign out
                            </button>
                        </form>
                        <button type="button" class="tva-profile-signout-all-btn" onclick="signOutAllProfiles()">
                            Sign out of all
                        </button>
                    </div>
                </div>
            </div>

            <div class="tva-theme-picker" style="position:relative; display:inline-block;">
                <button type="button" class="tva-theme-pill" style="display:inline-flex; align-items:center; gap:6px; padding:0 10px; height:34px; border-radius:99px; background:rgba(255,255,255,0.78); border:1.5px solid rgba(59,104,183,0.28); color:#1e293b; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.09); outline:none; font-family:Inter,sans-serif; white-space:nowrap;">
                    <span class="tva-pill-icon" style="font-size:15px; line-height:1;">☀️</span>
                    <i class="fa-solid fa-chevron-down" style="font-size:10px; color:#64748b;"></i>
                </button>
                <div class="tva-theme-popup" style="display:none; position:absolute; top:calc(100% + 8px); right:0; z-index:99999; flex-direction:column; gap:1px; min-width:172px; padding:5px; border-radius:14px; background:#fff; box-shadow:0 10px 28px rgba(15,23,42,0.16), 0 2px 6px rgba(15,23,42,0.06); border:1px solid #e2e8f0;">
                    <button type="button" class="tva-theme-opt" data-theme="light" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">☀️</span>
                        <span style="flex:1;">Light Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="dark" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">🌙</span>
                        <span style="flex:1;">Dark Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="gray-glass" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">💎</span>
                        <span style="flex:1;">Gray Glass</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="topbar-right-group" style="display:flex; align-items:center; gap:8px;">
            <% if (page === 'tasks') { %>
                <button class="btn primary btn-sm" data-open="task-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> Add Task
                </button>
            <% } %>


            <% if (page === 'employees') { %>
                <button class="btn primary btn-sm" data-open="employee-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-user-plus"></i> Add Team Member
                </button>
            <% } %>

            <% if (page === 'projects' && user.role === 'admin') { %>
                <button class="btn primary btn-sm" data-open="project-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> New Project
                </button>
            <% } %>

            <% if (typeof page !== 'undefined' && page === 'profile') { %>
                <form action="/logout" method="post" style="margin:0;">
                    <button class="logout-btn" style="white-space:nowrap;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                </form>
            <% } %>
        </div>
    </header>

    <!-- Add Another Account Modal (Chrome Profile Switcher) -->
    <div id="tvaAddAccountModal" style="display:none; position:fixed; inset:0; z-index:9999999; background:rgba(15,23,42,0.7); backdrop-filter:blur(4px); align-items:center; justify-content:center; padding:16px;">
        <div class="tva-add-modal-card">
            <div class="tva-add-modal-header">
                <div style="display:flex; align-items:center; gap:10px;">
                    <div class="tva-add-modal-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <div>
                        <h3 class="tva-add-modal-title">Add Another Account</h3>
                        <p class="tva-add-modal-sub">Sign in to save this profile for 1-click switching</p>
                    </div>
                </div>
                <button type="button" onclick="closeAddAccountModal()" class="tva-add-modal-close"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="tvaAddAccountForm" onsubmit="submitAddAccount(event)" style="padding:20px 22px;">
                <div id="tvaAddAccountAlert" style="display:none; padding:10px 12px; border-radius:8px; font-size:12.5px; margin-bottom:14px; line-height:1.4;"></div>
                
                <div style="margin-bottom:14px;">
                    <label class="tva-add-modal-label">Email address *</label>
                    <input type="email" id="tvaAddEmail" required placeholder="name@company.com" class="tva-add-modal-input">
                </div>

                <div style="margin-bottom:18px;">
                    <label class="tva-add-modal-label">Password *</label>
                    <input type="password" id="tvaAddPassword" required placeholder="••••••••" class="tva-add-modal-input">
                </div>

                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" onclick="closeAddAccountModal()" class="btn btn-outline tva-add-modal-cancel">Cancel</button>
                    <button type="submit" id="btnSubmitAddAccount" class="btn btn-primary" style="padding:8px 18px; font-size:13px; border-radius:8px; font-weight:600;">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In &amp; Add
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        window.TVA_CURRENT_ACCOUNT = <%- JSON.stringify(typeof currentAccount !== 'undefined' && currentAccount ? currentAccount : null) %>;
    </script>

    <main class="content">
