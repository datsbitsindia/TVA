<aside class="sidebar">
    <div class="brand" style="padding: 14px 10px 18px 10px; display: flex; align-items: center; justify-content: center; background: transparent !important; border: none !important; box-shadow: none !important;">
        <img src="/icons/tva-logo.png" alt="TVA Logo" class="brand-logo" style="height: auto; max-height: 110px; width: 100%; max-width: 220px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.06)); background: transparent !important;">
    </div>
    <nav>
        <% if (user.role === 'manager') { %>
            <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge"></i>Dashboard
            </a>
        <% } %>

        <% if (user.role === 'admin') { %>
            <a href="/projects" class="<%= page === 'projects' ? 'active' : '' %>">
                <i class="fa-solid fa-folder-open"></i>Projects
            </a>
        <% } %>

        <% if (user.role !== 'admin') { %>
            <a href="/tasks" class="<%= page === 'tasks' ? 'active' : '' %>">
                <i class="fa-solid fa-check-double"></i>Tasks
            </a>
        <% } %>

        <% if (user.role === 'manager' || user.role === 'admin') { %>
            <a href="/employees" class="<%= page === 'employees' || page === 'managers' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i>Teams
            </a>
        <% } %>




        <% if (user.role === 'admin') { %>
            <a href="/updates" class="<%= page === 'updates' ? 'active' : '' %>">
                <i class="fa-solid fa-list-check"></i>Updates
            </a>
        <% } %>

        <a href="/notifications" class="<%= page === 'notifications' ? 'active' : '' %>" style="position:relative;">
            <i class="fa-solid fa-bell"></i>Notifications
            <b class="badge" style="<%= (typeof unread !== 'undefined' && unread > 0) ? 'display:inline-block;' : 'display:none;' %>"><%= (typeof unread !== 'undefined' && unread > 0) ? unread : '' %></b>
        </a>

        <a href="/notes" class="<%= page === 'notes' ? 'active' : '' %>">
            <i class="fa-solid fa-note-sticky"></i>Notes
        </a>

        <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i class="fa-solid fa-user"></i>Profile
        </a>


    </nav>
</aside>

<section class="main">
    <% if (typeof impersonatingOrg !== 'undefined' && impersonatingOrg) { %>
        <div style="background: linear-gradient(90deg, #1e3a8a, #2563eb); color: white; padding: 10px 20px; font-size: 13.5px; font-weight: 600; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-user-ninja" style="color: #93c5fd;"></i>
                <span>Super Admin Mode: Viewing Organization <strong><%= impersonatingOrg.name %></strong></span>
            </div>
            <a href="/superadmin" style="background: rgba(255,255,255,0.22); color: white; padding: 4px 12px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 700; transition: background 0.15s;">
                <i class="fa-solid fa-arrow-left"></i> Exit to Super Admin Panel
            </a>
        </div>
    <% } %>

    <header class="topbar">
        <button class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-user-area" style="display: flex; align-items: center; gap: 10px; margin-right: auto;">
            <!-- Chrome / Google Profiles Switcher (Interactive) -->
            <div class="tva-profile-picker" style="position:relative; display:inline-block;">
                <button type="button" id="tvaProfileBtn" style="display:inline-flex; align-items:center; gap:8px; padding:3px 12px 3px 5px; height:36px; border-radius:99px; background:rgba(255,255,255,0.92); border:1.5px solid rgba(59,104,183,0.3); color:#0f172a; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.08); outline:none; font-family:Inter,sans-serif;" title="Switch Account / Profile">
                    <div style="width:28px; height:28px; border-radius:50%; background:linear-gradient(135deg, #2563eb, #7c3aed); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:12px; text-transform:uppercase; flex-shrink:0;">
                        <%= (user.name || 'U').charAt(0) %>
                    </div>
                    <div style="text-align:left; line-height:1.2; max-width:130px; overflow:hidden;">
                        <div style="font-size:12.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= user.name %></div>
                        <div style="font-size:10.5px; color:#64748b; font-weight:500; text-transform:capitalize; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= user.role %></div>
                    </div>
                    <i class="fa-solid fa-chevron-down" style="font-size:9px; color:#64748b;"></i>
                </button>

                <!-- Chrome Profile Popup Menu (Matching user photo) -->
                <div id="tvaProfileMenu" style="display:none; position:absolute; top:calc(100% + 8px); left:0; z-index:999999; width:295px; padding:12px; border-radius:18px; background:#18181b; color:#f4f4f5; box-shadow:0 18px 45px rgba(0,0,0,0.45), 0 4px 12px rgba(0,0,0,0.25); border:1px solid #27272a;">
                    <!-- Active User Card -->
                    <div style="display:flex; align-items:center; gap:10px; padding-bottom:12px; border-bottom:1px solid rgba(255,255,255,0.1);">
                        <div style="width:38px; height:38px; border-radius:50%; background:linear-gradient(135deg, #2563eb, #8b5cf6); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:15px; text-transform:uppercase; flex-shrink:0;">
                            <%= (user.name || 'U').charAt(0) %>
                        </div>
                        <div style="overflow:hidden; flex:1;">
                            <div style="font-size:13.5px; font-weight:700; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= user.name %></div>
                            <div style="font-size:11.5px; color:#a1a1aa; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><%= user.email %></div>
                            <div style="font-size:10.5px; color:#60a5fa; font-weight:600;"><%= (typeof currentOrg !== 'undefined' && currentOrg && currentOrg.name) ? currentOrg.name : 'Workspace' %> · <%= user.role %></div>
                        </div>
                        <span style="font-size:10px; font-weight:700; padding:2px 7px; border-radius:99px; background:rgba(37,99,235,0.25); color:#93c5fd; border:1px solid rgba(96,165,250,0.3);">Active</span>
                    </div>

                    <!-- Other Chrome profiles Style Header -->
                    <div style="margin-top:10px;">
                        <div style="font-size:11.5px; font-weight:700; color:#e4e4e7; padding:4px 6px 8px; letter-spacing:0.3px; display:flex; align-items:center; justify-content:space-between;">
                            <span>Other Profiles</span>
                            <span id="tvaProfilesCount" style="font-size:10.5px; color:#71717a; font-weight:500;"></span>
                        </div>
                        <div id="tvaOtherProfilesContainer" style="display:flex; flex-direction:column; gap:3px; max-height:210px; overflow-y:auto;">
                            <!-- Populated dynamically via JS from localStorage -->
                        </div>
                    </div>

                    <!-- Add Another Account Button -->
                    <div style="border-top:1px solid rgba(255,255,255,0.1); margin-top:10px; padding-top:8px;">
                        <button type="button" onclick="openAddAccountModal()" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 12px; border:none; background:rgba(255,255,255,0.06); color:#f4f4f5; border-radius:10px; cursor:pointer; font-size:12.5px; font-weight:600; font-family:Inter,sans-serif; transition:background 0.15s;">
                            <i class="fa-solid fa-user-plus" style="font-size:12px; color:#60a5fa;"></i>
                            <span>Add another account</span>
                        </button>
                    </div>

                    <!-- Super Admin Link (if applicable) -->
                    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                        <div style="border-top:1px solid rgba(255,255,255,0.1); margin-top:8px; padding-top:8px;">
                            <a href="/superadmin" style="display:flex; align-items:center; gap:8px; width:100%; padding:8px 12px; border-radius:10px; text-decoration:none; font-size:12px; font-weight:600; color:#c084fc; background:rgba(168,85,247,0.15); box-sizing:border-box;">
                                <i class="fa-solid fa-crown" style="font-size:11px;"></i>
                                <span>Super Admin Platform</span>
                            </a>
                        </div>
                    <% } %>

                    <!-- Sign Out Options -->
                    <div style="border-top:1px solid rgba(255,255,255,0.08); margin-top:8px; padding-top:8px; display:flex; justify-content:space-between; align-items:center;">
                        <form action="/logout" method="post" style="margin:0;">
                            <button type="submit" style="background:none; border:none; color:#f87171; font-size:11.5px; font-weight:600; cursor:pointer; padding:4px 6px; font-family:Inter,sans-serif;">
                                <i class="fa-solid fa-right-from-bracket"></i> Sign out
                            </button>
                        </form>
                        <button type="button" onclick="signOutAllProfiles()" style="background:none; border:none; color:#a1a1aa; font-size:11.5px; font-weight:500; cursor:pointer; padding:4px 6px; font-family:Inter,sans-serif;">
                            Sign out of all
                        </button>
                    </div>
                </div>
            </div>

            <div class="tva-theme-picker" style="position:relative; display:inline-block;">
                <button type="button" class="tva-theme-pill" style="display:inline-flex; align-items:center; gap:6px; padding:0 10px; height:34px; border-radius:99px; background:rgba(255,255,255,0.78); border:1.5px solid rgba(59,104,183,0.28); color:#1e293b; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.09); outline:none; font-family:Inter,sans-serif; white-space:nowrap;">
                    <span class="tva-pill-icon" style="font-size:15px; line-height:1;">☀️</span>
                    <i class="fa-solid fa-chevron-down" style="font-size:10px; color:#64748b;"></i>
                </button>
                <div class="tva-theme-popup" style="display:none; position:absolute; top:calc(100% + 8px); right:0; z-index:99999; flex-direction:column; gap:1px; min-width:172px; padding:5px; border-radius:14px; background:#fff; box-shadow:0 10px 28px rgba(15,23,42,0.16), 0 2px 6px rgba(15,23,42,0.06); border:1px solid #e2e8f0;">
                    <button type="button" class="tva-theme-opt" data-theme="light" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">☀️</span>
                        <span style="flex:1;">Light Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="dark" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">🌙</span>
                        <span style="flex:1;">Dark Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="gray-glass" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">💎</span>
                        <span style="flex:1;">Gray Glass</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="topbar-right-group" style="display:flex; align-items:center; gap:8px;">
            <% if (page === 'tasks') { %>
                <button class="btn primary btn-sm" data-open="task-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> Add Task
                </button>
            <% } %>


            <% if (page === 'employees') { %>
                <button class="btn primary btn-sm" data-open="employee-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-user-plus"></i> Add Team Member
                </button>
            <% } %>

            <% if (page === 'projects' && user.role === 'admin') { %>
                <button class="btn primary btn-sm" data-open="project-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> New Project
                </button>
            <% } %>

            <% if (typeof page !== 'undefined' && page === 'profile') { %>
                <form action="/logout" method="post" style="margin:0;">
                    <button class="logout-btn" style="white-space:nowrap;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
                </form>
            <% } %>
        </div>
    </header>

    <!-- Add Another Account Modal (Chrome Profile Switcher) -->
    <div id="tvaAddAccountModal" style="display:none; position:fixed; inset:0; z-index:9999999; background:rgba(15,23,42,0.7); backdrop-filter:blur(4px); align-items:center; justify-content:center; padding:16px;">
        <div style="width:100%; max-width:390px; background:#ffffff; border-radius:20px; box-shadow:0 24px 60px rgba(0,0,0,0.3); border:1px solid #e2e8f0; overflow:hidden;">
            <div style="padding:18px 22px 14px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <div style="width:34px; height:34px; border-radius:50%; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:14px;">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <div>
                        <h3 style="font-size:15px; font-weight:700; color:#0f172a; margin:0;">Add Another Account</h3>
                        <p style="font-size:11.5px; color:#64748b; margin:2px 0 0;">Sign in to save this profile for 1-click switching</p>
                    </div>
                </div>
                <button type="button" onclick="closeAddAccountModal()" style="border:none; background:none; color:#94a3b8; cursor:pointer; font-size:18px; padding:4px;"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="tvaAddAccountForm" onsubmit="submitAddAccount(event)" style="padding:20px 22px;">
                <div id="tvaAddAccountAlert" style="display:none; padding:10px 12px; border-radius:8px; font-size:12.5px; margin-bottom:14px; line-height:1.4;"></div>
                
                <div style="margin-bottom:14px;">
                    <label style="display:block; font-size:12px; font-weight:600; color:#334155; margin-bottom:6px;">Email address *</label>
                    <input type="email" id="tvaAddEmail" required placeholder="name@company.com" style="width:100%; height:40px; padding:0 12px; border-radius:8px; border:1.5px solid #cbd5e1; font-size:13.5px; outline:none; box-sizing:border-box;">
                </div>

                <div style="margin-bottom:18px;">
                    <label style="display:block; font-size:12px; font-weight:600; color:#334155; margin-bottom:6px;">Password *</label>
                    <input type="password" id="tvaAddPassword" required placeholder="••••••••" style="width:100%; height:40px; padding:0 12px; border-radius:8px; border:1.5px solid #cbd5e1; font-size:13.5px; outline:none; box-sizing:border-box;">
                </div>

                <div style="display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" onclick="closeAddAccountModal()" class="btn btn-outline" style="padding:8px 14px; font-size:13px; border-radius:8px;">Cancel</button>
                    <button type="submit" id="btnSubmitAddAccount" class="btn btn-primary" style="padding:8px 18px; font-size:13px; border-radius:8px; font-weight:600;">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In &amp; Add
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        window.TVA_CURRENT_ACCOUNT = <%- JSON.stringify(typeof currentAccount !== 'undefined' && currentAccount ? currentAccount : null) %>;
    </script>

    <main class="content">
