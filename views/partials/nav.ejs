<aside class="sidebar">
    <div class="brand" style="padding: 14px 10px 18px 10px; display: flex; align-items: center; justify-content: center; background: transparent !important; border: none !important; box-shadow: none !important;">
        <img src="/icons/tva-logo.png" alt="TVA Logo" class="brand-logo" style="height: auto; max-height: 110px; width: 100%; max-width: 220px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.06)); background: transparent !important;">
    </div>
    <nav>
        <% if (user.role === 'manager') { %>
            <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge"></i>Dashboard
            </a>
        <% } %>

        <% if (user.role === 'admin') { %>
            <a href="/projects" class="<%= page === 'projects' ? 'active' : '' %>">
                <i class="fa-solid fa-folder-open"></i>Projects
            </a>
        <% } %>

        <% if (user.role !== 'admin') { %>
            <a href="/tasks" class="<%= page === 'tasks' ? 'active' : '' %>">
                <i class="fa-solid fa-check-double"></i>Tasks
            </a>
        <% } %>

        <% if (user.role === 'manager' || user.role === 'admin') { %>
            <a href="/employees" class="<%= page === 'employees' || page === 'managers' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i>Teams
            </a>
        <% } %>




        <% if (user.role === 'admin') { %>
            <a href="/updates" class="<%= page === 'updates' ? 'active' : '' %>">
                <i class="fa-solid fa-list-check"></i>Updates
            </a>
        <% } %>

        <a href="/notifications" class="<%= page === 'notifications' ? 'active' : '' %>" style="position:relative;">
            <i class="fa-solid fa-bell"></i>Notifications
            <b class="badge" style="<%= (typeof unread !== 'undefined' && unread > 0) ? 'display:inline-block;' : 'display:none;' %>"><%= (typeof unread !== 'undefined' && unread > 0) ? unread : '' %></b>
        </a>

        <a href="/notes" class="<%= page === 'notes' ? 'active' : '' %>">
            <i class="fa-solid fa-note-sticky"></i>Notes
        </a>

        <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">
            <i class="fa-solid fa-user"></i>Profile
        </a>
    </nav>
</aside>

<section class="main">
    <header class="topbar">
        <button class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-user-area" style="display: flex; align-items: center; gap: 10px; margin-right: auto;">
            <div class="topbar-user" style="margin-right: 0;">
                <strong><%= user.name %></strong>
                <small><%= user.role %><% if (typeof currentOrg !== 'undefined' && currentOrg && currentOrg.name) { %> · <%= currentOrg.name %><% } %></small>
            </div>

            <div class="tva-theme-picker" style="position:relative; display:inline-block;">
                <button type="button" class="tva-theme-pill" style="display:inline-flex; align-items:center; gap:7px; padding:0 14px 0 10px; height:34px; border-radius:99px; background:rgba(255,255,255,0.78); border:1.5px solid rgba(59,104,183,0.28); color:#1e293b; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.09); outline:none; font-family:Inter,sans-serif; white-space:nowrap;">
                    <span class="tva-pill-icon" style="font-size:15px; line-height:1;">☀️</span>
                    <span class="tva-pill-name">Light Theme</span>
                    <i class="fa-solid fa-chevron-down" style="font-size:10px; color:#64748b; margin-left:2px;"></i>
                </button>
                <div class="tva-theme-popup" style="display:none; position:absolute; top:calc(100% + 8px); right:0; z-index:99999; flex-direction:column; gap:1px; min-width:172px; padding:5px; border-radius:14px; background:#fff; box-shadow:0 10px 28px rgba(15,23,42,0.16), 0 2px 6px rgba(15,23,42,0.06); border:1px solid #e2e8f0;">
                    <button type="button" class="tva-theme-opt" data-theme="light" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">☀️</span>
                        <span style="flex:1;">Light Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="dark" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">🌙</span>
                        <span style="flex:1;">Dark Theme</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                    <button type="button" class="tva-theme-opt" data-theme="gray-glass" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                        <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">💎</span>
                        <span style="flex:1;">Gray Glass</span>
                        <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="topbar-right-group" style="display:flex; align-items:center; gap:8px;">
            <% if (page === 'tasks') { %>
                <button class="btn primary btn-sm" data-open="task-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> Add Task
                </button>
            <% } %>


            <% if (page === 'employees') { %>
                <button class="btn primary btn-sm" data-open="employee-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-user-plus"></i> Add Team Member
                </button>
            <% } %>

            <% if (page === 'projects' && user.role === 'admin') { %>
                <button class="btn primary btn-sm" data-open="project-modal" style="white-space:nowrap;">
                    <i class="fa-solid fa-plus"></i> New Project
                </button>
            <% } %>

            <form action="/logout" method="post" style="margin:0;">
                <button class="logout-btn" style="white-space:nowrap;"><i class="fa-solid fa-right-from-bracket"></i> Logout</button>
            </form>
        </div>
    </header>

    <main class="content">
