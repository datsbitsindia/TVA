<%- include('partials/head',{title:'Reports'}) %>
<%- include('partials/nav',{page:'reports'}) %>

<div class="toolbar-ui filter-bar" style="margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
    <form method="GET" action="/reports" style="display: flex; gap: 10px; align-items: center; flex: 1; min-width: 280px; flex-wrap: wrap;">
        <i class="fa-solid fa-filter" style="color: #5b5fc7; font-size: 15px;"></i>
        <span style="font-weight: 700; font-size: 13px;">Filter by Project:</span>
        <select name="project_id" onchange="this.form.submit()" style="max-width: 250px; flex: 1;">
            <option value="">All Projects</option>
            <% (typeof projects !== 'undefined' ? projects : []).forEach(p => { %>
                <option value="<%= p.id %>" <%= String(selectedProject) === String(p.id) ? 'selected' : '' %>>
                    <%= p.name %>
                </option>
            <% }) %>
        </select>
        <% if (selectedProject) { %>
            <a href="/reports" class="btn btn-sm secondary" style="font-size: 11px; padding: 4px 10px;">
                <i class="fa-solid fa-xmark"></i> Clear Filter
            </a>
        <% } %>
    </form>
    <a href="/reports/export<%= selectedProject ? '?project_id=' + selectedProject : '' %>" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px; background: #15803d; border-color: #166534; color: #ffffff; padding: 8px 16px; font-weight: 700; border-radius: 8px; text-decoration: none; font-size: 13px; white-space: nowrap; box-shadow: 0 2px 4px rgba(21,128,61,0.25);">
        <i class="fa-solid fa-file-excel" style="font-size: 16px;"></i> Export Excel Report
    </a>
</div>

<% const total=byStatus.reduce((s,x)=>s+Number(x.value),0), status=(n)=>Number((byStatus.find(x=>String(x.label).toLowerCase()===n)||{}).value||0), completed=status('completed'), rate=total?Math.round(completed/total*100):0, activeEmployees=byEmployee.filter(x=>Number(x.value)>0).length, busiest=byEmployee[0]; %>
<div class="report-summary"><div><span>Completion Rate</span><b><%= rate %>%</b><small><%= completed %> of <%= total %> tasks</small></div><div><span>Active Employees</span><b><%= activeEmployees %></b><small>With assigned work</small></div><div><span>Due in 3 Days</span><b><%= dueSoon %></b><small>Needs planning</small></div><div class="<%= overdue?'risk':'' %>"><span>Overdue</span><b><%= overdue %></b><small><%= overdue?'Needs attention':'All on schedule' %></small></div></div>
<section class="report-insight"><div><i class="fa-solid fa-bullseye"></i><div><b>Manager Summary</b><p><% if(rate>=75){ %>Delivery is healthy with a <%= rate %>% completion rate.<% } else if(rate>=40){ %>Delivery is progressing; focus on pending and overdue tasks.<% } else { %>Completion is currently low. Review workload and blockers with the team.<% } %></p></div></div><div><i class="fa-solid fa-user-check"></i><div><b>Highest Workload</b><p><%= busiest&&Number(busiest.value)?`${busiest.label} has ${busiest.value} assigned tasks.`:'No employee workload available.' %></p></div></div></section>
<div class="report-layout"><section class="ui-panel chart-panel report-chart"><div class="ui-panel-head"><h2>Task Status</h2><span><%= total %> total</span></div><canvas id="statusChart" data-values='<%- JSON.stringify(byStatus) %>'></canvas></section><section class="ui-panel"><div class="ui-panel-head"><h2>Employee Workload</h2><span>Assigned / Completed</span></div><div class="formal-bars"><% const empMax=Math.max(1,...byEmployee.map(x=>Number(x.value))); byEmployee.forEach(x=>{ const done=Number(x.completed||0),value=Number(x.value); %><div class="formal-row"><div><b><%= x.label %></b><small><%= done %> completed</small></div><div class="progress-track"><i style="width:<%= Math.round(value/empMax*100) %>%"></i></div><strong><%= value %></strong></div><% }) %></div></section></div>
<section class="ui-panel project-performance"><div class="ui-panel-head"><h2>Project Performance</h2><span>Task completion by project</span></div><div class="project-report-list"><% byProject.forEach(x=>{ const value=Number(x.value),done=Number(x.completed||0),pct=value?Math.round(done/value*100):0; %><article><div><b><%= x.label %></b><small><%= done %>/<%= value %> tasks completed</small></div><div class="progress-track"><i style="width:<%= pct %>%"></i></div><strong><%= pct %>%</strong><span class="status-chip <%= pct===100?'completed':pct?'in-progress':'pending' %>"><%= pct===100?'Completed':pct?'In progress':'Not started' %></span></article><% }) %><% if(!byProject.length){ %><p class="empty">No project data available.</p><% } %></div></section>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const canvas = document.getElementById('statusChart');
    if (!canvas || typeof Chart === 'undefined') return;
    
    let rawData = [];
    try {
        rawData = JSON.parse(canvas.getAttribute('data-values') || '[]');
    } catch(e) {}

    const labelMap = {
        'pending': 'Pending',
        'in progress': 'In Progress',
        'completed': 'Completed',
        'cancelled': 'Cancelled'
    };

    const statusCounts = {
        'Completed': 0,
        'In Progress': 0,
        'Pending': 0,
        'Cancelled': 0
    };

    rawData.forEach(item => {
        const key = labelMap[String(item.label).toLowerCase()] || item.label;
        if (statusCounts[key] !== undefined) {
            statusCounts[key] += Number(item.value || 0);
        }
    });

    const labels = ['Completed', 'In Progress', 'Pending', 'Cancelled'];
    const data = labels.map(l => statusCounts[l]);
    const colors = ['#10b981', '#3b82f6', '#f59e0b', '#ef4444'];

    new Chart(canvas.getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: labels,
            datasets: [{
                data: data,
                backgroundColor: colors,
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        padding: 10,
                        font: { size: 11, family: "'Inter', sans-serif" }
                    }
                }
            },
            cutout: '68%'
        }
    });
});
</script>
<%- include('partials/foot') %>
