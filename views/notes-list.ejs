<%- include('partials/head', { title: 'My Private Notes - TVA' }) %>
<%- include('partials/nav') %>

<style>
.notes-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
}

.notes-page-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 10px;
}

.notes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.note-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 8px 12px 8px 16px;
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    position: relative;
    overflow: hidden;
}

.note-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #6366f1;
    border-radius: 4px 0 0 4px;
}

.note-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.12);
    border-color: #c7d2fe;
}

.note-card-title {
    font-size: 14px;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.note-card-snippet {
    font-size: 12px;
    color: #64748b;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    margin-bottom: 4px;
}

.note-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    font-size: 10px;
    color: #94a3b8;
}

.empty-notes-box {
    background: #ffffff;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    padding: 50px 20px;
    text-align: center;
    color: #64748b;
}

mark.note-search-highlight {
    background-color: #fef08a;
    color: #854d0e;
    padding: 1px 4px;
    border-radius: 4px;
    font-weight: 700;
}

/* Dark Theme Overrides for Notes Page */
html.dark-theme .notes-page-header h2 {
    color: #ffffff !important;
}
html.dark-theme .notes-page-header span {
    background: rgba(255, 255, 255, 0.06) !important;
    color: #cccccc !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
}
html.dark-theme .empty-notes-box {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 2px dashed rgba(255, 255, 255, 0.08) !important;
    color: #cccccc !important;
}
html.dark-theme .empty-notes-box h3,
html.dark-theme .empty-notes-box p {
    color: #cccccc !important;
}
html.dark-theme .empty-notes-box i {
    color: #ffffff !important;
}
html.dark-theme .note-card {
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    color: #cccccc !important;
}
html.dark-theme .note-card-title {
    color: #ffffff !important;
}
html.dark-theme .note-card-snippet {
    color: #aaaaaa !important;
}
html.dark-theme .notes-search-box input {
    background: rgba(255, 255, 255, 0.04) !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
}

/* Gray Glass Theme Overrides for Notes Page */
html.gray-glass-theme .notes-page-header h2 {
    color: #0F172A !important;
}
html.gray-glass-theme .notes-page-header span {
    background: rgba(255, 255, 255, 0.3) !important;
    color: #1E293B !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
}
html.gray-glass-theme .empty-notes-box {
    background: rgba(255, 255, 255, 0.18) !important;
    border: 2px dashed rgba(255, 255, 255, 0.4) !important;
    color: #334155 !important;
    backdrop-filter: blur(16px) !important;
}
html.gray-glass-theme .empty-notes-box h3,
html.gray-glass-theme .empty-notes-box p {
    color: #334155 !important;
}
html.gray-glass-theme .empty-notes-box i {
    color: #0F172A !important;
}
html.gray-glass-theme .note-card {
    background: rgba(255, 255, 255, 0.18) !important;
    border: 1px solid rgba(255, 255, 255, 0.25) !important;
    color: #0F172A !important;
    backdrop-filter: blur(16px) !important;
}
html.gray-glass-theme .note-card-title {
    color: #0F172A !important;
}
html.gray-glass-theme .note-card-snippet {
    color: #334155 !important;
}
html.gray-glass-theme .notes-search-box input {
    background: rgba(255, 255, 255, 0.25) !important;
    color: #0F172A !important;
    border: 1px solid rgba(255, 255, 255, 0.35) !important;
}
</style>

<div class="notes-page-header">
    <h2>
        <i class="fa-solid fa-sticky-note" style="color:#6366f1;"></i> My Private Notes
        <span style="font-size:12px; font-weight:600; background:#e0e7ff; color:#4338ca; padding:3px 10px; border-radius:99px;">
            <%= notes.length %> <%= notes.length === 1 ? 'Note' : 'Notes' %>
        </span>
    </h2>
    <form action="/notes/create" method="post" style="margin:0;">
        <button type="submit" class="btn primary" style="font-weight:700; border-radius:10px; padding:8px 16px; display:inline-flex; align-items:center; gap:8px;">
            <i class="fa-solid fa-plus"></i> New Note
        </button>
    </form>
</div>

<!-- Search Bar -->
<div class="notes-search-box" style="margin-bottom: 20px;">
    <form action="/notes" method="get" onsubmit="return false;" style="display:flex; gap:10px; align-items:center; width:100%;">
        <div style="position:relative; flex:1;">
            <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:14px;"></i>
            <input type="search" name="q" id="notes-search-input" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Search notes by title or content..." style="width:100%; padding:10px 14px 10px 38px; border:1px solid #cbd5e1; border-radius:10px; font-size:14px; outline:none; transition:all 0.2s ease; background:#fff;">
        </div>
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a href="/notes" class="btn outline" style="font-weight:700; border-radius:10px; padding:10px 14px; display:inline-flex; align-items:center; gap:4px; flex-shrink:0; text-decoration:none;">
                <i class="fa-solid fa-xmark"></i> Clear
            </a>
        <% } %>
    </form>
</div>

<% if (notes && notes.length > 0) { %>
    <div class="notes-grid" id="notes-grid-container">
        <% notes.forEach(n => { 
            const noteTitle = n.title || 'Untitled Note';
            const noteSnippet = n.details ? n.details.replace(/<[^>]*>?/gm, '').substring(0, 100) : 'Empty note...';
        %>
            <a href="/notes/<%= n.id %>" class="note-card">
                <div class="note-card-title" data-original-text="<%= noteTitle %>"><%= noteTitle %></div>
                <div class="note-card-snippet" data-original-text="<%= noteSnippet %>"><%= noteSnippet %></div>
                <div class="note-card-footer">
                    <span><i class="fa-regular fa-clock"></i> <%= formatDateTime(n.updated_at) %></span>
                </div>
            </a>
        <% }) %>
    </div>
<% } else { %>
    <div class="empty-notes-box">
        <i class="fa-solid fa-note-sticky" style="font-size:54px; color:#cbd5e1; margin-bottom:16px;"></i>
        <h3 style="margin:0 0 8px; color:#1e293b;">
            <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'No matching notes found' : 'No notes found' %>
        </h3>
        <p style="margin:0 0 20px; font-size:14px; color:#64748b;">
            <%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'No notes matched "' + searchQuery + '". Try searching for different keywords.' : 'Create your first private note to keep track of your personal tasks, ideas, and reminders.' %>
        </p>
        <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <a href="/notes" class="btn primary" style="font-weight:700; border-radius:10px; display:inline-flex; align-items:center; gap:6px; text-decoration:none;">
                <i class="fa-solid fa-arrow-left"></i> View All Notes
            </a>
        <% } else { %>
            <form action="/notes/create" method="post" style="margin:0; display:inline-block;">
                <button type="submit" class="btn primary" style="font-weight:700; border-radius:10px;">
                    <i class="fa-solid fa-plus"></i> Create Note Now
                </button>
            </form>
        <% } %>
    </div>
<% } %>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const input = document.getElementById('notes-search-input');
    const container = document.getElementById('notes-grid-container');
    if (!container) return;

    function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightMatch(element, originalText, query) {
        if (!query) {
            element.textContent = originalText;
            return;
        }
        const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
        element.innerHTML = originalText.replace(regex, '<mark class="note-search-highlight">$1</mark>');
    }

    function applyFilterAndHighlight() {
        const query = (input ? input.value : '').trim();
        const cards = container.querySelectorAll('.note-card');
        
        cards.forEach(card => {
            const titleEl = card.querySelector('.note-card-title');
            const snippetEl = card.querySelector('.note-card-snippet');
            const origTitle = titleEl ? (titleEl.getAttribute('data-original-text') || titleEl.textContent) : '';
            const origSnippet = snippetEl ? (snippetEl.getAttribute('data-original-text') || snippetEl.textContent) : '';

            const titleLower = origTitle.toLowerCase();
            const snippetLower = origSnippet.toLowerCase();
            const queryLower = query.toLowerCase();

            if (!queryLower || titleLower.includes(queryLower) || snippetLower.includes(queryLower)) {
                card.style.display = 'flex';
                if (titleEl) highlightMatch(titleEl, origTitle, query);
                if (snippetEl) highlightMatch(snippetEl, origSnippet, query);
            } else {
                card.style.display = 'none';
            }
        });
    }

    if (input) {
        input.addEventListener('input', applyFilterAndHighlight);
    }
    applyFilterAndHighlight();
});
</script>

<%- include('partials/foot') %>


