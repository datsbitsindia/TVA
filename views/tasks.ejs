<%- include('partials/head', { title: 'Tasks' }) %>
<%- include('partials/nav', { page: 'tasks' }) %>

<%
    const done = typeof kpiCounts !== 'undefined' ? kpiCounts.completed : tasks.filter(t => String(t.status).toLowerCase() === 'completed').length;
    const pending = typeof kpiCounts !== 'undefined' ? kpiCounts.pending : tasks.filter(t => String(t.status).toLowerCase() === 'pending').length;
    const progress = typeof kpiCounts !== 'undefined' ? kpiCounts.progress : tasks.filter(t => String(t.status).toLowerCase() === 'in progress').length;
    const overdueCount = typeof kpiCounts !== 'undefined' ? kpiCounts.overdueCount : tasks.filter(t => t.is_overdue).length;
    const totalCount = typeof kpiCounts !== 'undefined' ? kpiCounts.total : tasks.length;
    const activeKpiStatus = (typeof filters !== 'undefined' && filters.status !== undefined) ? String(filters.status).toLowerCase().trim() : 'pending';
%>

<div class="metric-grid task-kpis five">

    <div class="metric-card red <%= activeKpiStatus === 'overdue' ? 'active-kpi-filter' : '' %>" onclick="filterByKpi('Overdue', event)" title="Click to filter Overdue tasks">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <b><%= overdueCount %></b>
        <span>Overdue</span>
    </div>

    <div class="metric-card orange <%= activeKpiStatus === 'pending' ? 'active-kpi-filter' : '' %>" onclick="filterByKpi('Pending', event)" title="Click to filter Pending tasks">
        <i class="fa-regular fa-clock"></i>
        <b><%= pending %></b>
        <span>Pending</span>
    </div>

    <div class="metric-card purple <%= (activeKpiStatus === 'in progress' || activeKpiStatus === 'in-progress') ? 'active-kpi-filter' : '' %>" onclick="filterByKpi('In Progress', event)" title="Click to filter In Progress tasks">
        <i class="fa-solid fa-spinner"></i>
        <b><%= progress %></b>
        <span>In Progress</span>
    </div>

    <div class="metric-card green <%= activeKpiStatus === 'completed' ? 'active-kpi-filter' : '' %>" onclick="filterByKpi('Completed', event)" title="Click to filter Completed tasks">
        <i class="fa-regular fa-circle-check"></i>
        <b><%= done %></b>
        <span>Completed</span>
    </div>

    <div class="metric-card <%= activeKpiStatus === 'all' ? 'active-kpi-filter' : '' %>" onclick="filterByKpi('all', event)" title="Click to show all tasks">
        <i class="fa-solid fa-list-check"></i>
        <b><%= totalCount %></b>
        <span>Total Tasks</span>
    </div>

</div>

<%
    const overdueTasks = tasks.filter(t => t.is_overdue);
    const routineTasksToday = tasks.filter(t => t.is_routine && String(t.status).toLowerCase() !== 'completed');
%>

<% if (user.role === 'manager' && typeof dailyRoutines !== 'undefined' && dailyRoutines.length) { %>
    <section class="ui-panel routine-panel">
        <div class="ui-panel-head">
            <h2><i class="fa-solid fa-repeat" style="color: #5b5fc7;"></i> Active Daily Routines (Timeline Schedules)</h2>
            <span class="muted"><%= dailyRoutines.length %> schedule<%= dailyRoutines.length > 1 ? 's' : '' %></span>
        </div>
        <div class="routine-grid">
            <% dailyRoutines.forEach(r => { %>
                <article class="routine-card">
                    <div class="routine-card-top">
                        <div class="routine-card-info">
                            <b><%= r.title %></b>
                            <small>#<%= r.id %> <%= r.project_name %> · <%= (r.description || '').replace(/<[^>]*>?/gm, '').trim() || 'Daily routine task' %></small>

                        </div>
                        <span class="status-chip <%= r.active ? 'in-progress' : 'cancelled' %>">
                            <%= r.active ? 'Active' : 'Paused' %>
                        </span>
                    </div>

                    <div class="routine-card-meta">
                        <div>
                            <small>Assigned To</small>
                            <b><%= r.assigned_name %></b>
                        </div>
                        <div>
                            <small>Timeline</small>
                            <b><%= formatDate(r.start_date) %> ➔ <%= formatDate(r.end_date) %></b>
                        </div>
                        <div>
                            <small>Daily Time</small>
                            <b><i class="fa-regular fa-clock"></i> <%= r.daily_time %></b>
                        </div>
                    </div>

                    <div class="routine-card-actions">
                        <form action="/tasks/routine/<%= r.id %>/toggle" method="POST" style="display:inline;">
                            <button class="btn btn-sm <%= r.active ? 'secondary' : 'primary' %>" title="<%= r.active ? 'Pause Routine' : 'Activate Routine' %>">
                                <i class="fa-solid <%= r.active ? 'fa-pause' : 'fa-play' %>"></i> <%= r.active ? 'Pause' : 'Activate' %>
                            </button>
                        </form>
                        <form action="/tasks/routine/<%= r.id %>/delete" method="POST" style="display:inline;" data-confirm="Delete this routine schedule?">
                            <button class="btn btn-sm danger-btn" title="Delete Routine">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<% if (user.role === 'employee' && routineTasksToday.length) { %>
    <div class="routine-alert-banner">
        <div class="routine-alert-head">
            <i class="fa-solid fa-sun icon-sun"></i>
            <div>
                <h3><i class="fa-solid fa-clock-rotate-left"></i> Today's Daily Routine (Must Complete First)</h3>
                <p>Please complete your assigned daily routine tasks before starting other regular tasks.</p>
            </div>
        </div>
        <div class="routine-card-grid">
            <% routineTasksToday.forEach(rt => { %>
                <div class="routine-highlight-card">
                    <div class="routine-card-header">
                        <span class="routine-badge"><i class="fa-solid fa-repeat"></i> Daily Routine</span>
                        <span class="status-chip <%= rt.status.toLowerCase().replaceAll(' ', '-') %>"><%= rt.status %></span>
                    </div>
                    <h4><a href="/tasks/<%= rt.id %>"><%= rt.title %></a></h4>
                    <p><%= rt.description || 'Complete daily morning routine' %></p>
                    <div class="routine-card-footer">
                        <small><i class="fa-solid fa-folder"></i> #<%= rt.task_number || rt.id %> <%= rt.project_name || 'Project' %></small>
                        <a href="/tasks/<%= rt.id %>" class="btn btn-sm primary">Start / Complete</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
<% } %>

<% if (overdueTasks.length) { %>
    <div class="overdue-alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <b>
                <%= overdueTasks.length %>
                overdue task<%= overdueTasks.length > 1 ? 's' : '' %>
            </b>
            <span>
                <%= user.role === 'manager'
                    ? 'Employee tasks are overdue. Please follow up urgently.'
                    : 'Due date has passed. Please complete the task urgently.'
                %>
            </span>
        </div>
    </div>
<% } %>

<%
    const myId = user.id;
    const assignedToMeTasks = tasks.filter(t => {
        const ids = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
        return ids.includes(myId);
    });

    const assignedByMeTasks = tasks.filter(t => {
        const ids = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
        return Number(t.created_by) === myId && !ids.every(id => id === myId);
    });
%>

<section class="ui-panel">

    <div class="task-type-tabs-container" style="display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 8px !important; margin-bottom: 12px !important;">
        <button type="button" class="btn task-tab-btn active" data-task-tab="assigned-to-me" onclick="filterTaskType('assigned-to-me', this)">
            <i class="fa-solid fa-inbox"></i> To Do
        </button>
        <button type="button" class="btn task-tab-btn" data-task-tab="assigned-by-me" onclick="filterTaskType('assigned-by-me', this)">
            <i class="fa-solid fa-paper-plane"></i> Assigned
        </button>
    </div>



    <div class="toolbar-ui compact-filter" style="margin-bottom: 16px;">
        <input
            type="search"
            placeholder="Search tasks..."
            oninput="applyCompactFilter(this.closest('.compact-filter'))"
        >

        <select onchange="applyCompactFilter(this.closest('.compact-filter'))">
            <option>All Projects</option>
            <% projects.forEach(p => { %>
                <option><%= p.name %></option>
            <% }) %>
        </select>
    </div>

    <div class="entity-list">

        <% tasks.forEach(t => { %>
            <%
                const assignedIds = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
                const isPureSelf = t.is_self_task || String(t.project_name).toLowerCase() === 'self task' || (Number(t.created_by) === user.id && assignedIds.length === 1 && assignedIds[0] === user.id);
                const isAssignedByMe = Number(t.created_by) === user.id && !isPureSelf;
                const isAssignedToMe = assignedIds.includes(user.id);
                const filterGroup = isPureSelf ? 'self' : isAssignedByMe ? 'assigned-by-me' : 'assigned-to-me';
            %>

            <article
                class="entity-card task-card <%= t.is_overdue ? 'overdue-card' : '' %> <%= t.is_routine ? 'routine-task-card' : '' %>"
                data-status="<%= String(t.status).toLowerCase().replaceAll(' ', '-') %>"
                data-overdue="<%= t.is_overdue ? 'true' : 'false' %>"
                data-forwarded="<%= t.is_forwarded ? 'true' : 'false' %>"
                data-project="<%= (t.project_name || '').toLowerCase() %>"
                data-filter-group="<%= filterGroup %>"
                data-priority="<%= (t.priority || '').toLowerCase() %>"
                data-completed-at="<%= t.completed_at ? new Date(t.completed_at).getTime() : 0 %>"
                data-created-at="<%= t.created_at ? new Date(t.created_at).getTime() : 0 %>"
                data-id="<%= t.id %>"
            >

                <div class="entity-title">

                    <div class="task-title-row" style="display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; overflow: hidden; width: 100%;">

                        <a href="/tasks/<%= t.id %>" style="font-weight: 800; font-size: 14px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 40px;">
                            #<%= t.task_number || t.id %> <%= t.title %>
                        </a>

                        <% if (t.is_routine) { %>
                            <span class="routine-badge" style="flex:0 0 auto; margin:0!important;"><i class="fa-solid fa-repeat"></i> Routine</span>
                        <% } %>

                        <% if (isPureSelf) { %>
                            <span class="status-chip self-task" style="background:#e0e7ff;color:#4338ca;border:1px solid #c7d2fe;padding:2px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;margin:0!important;">
                                <i class="fa-solid fa-user-check"></i> Self Task
                            </span>
                        <% } %>

                        <span class="priority-pill <%= t.priority.toLowerCase() %>" style="font-weight:700; font-size:9px; padding:2px 6px; border-radius:99px; flex:0 0 auto; margin:0!important;">
                            <i class="fa-solid fa-flag"></i> <%= t.priority %>
                        </span>

                        <% if (t.is_forwarded) { %>
                            <span class="status-chip forwarded" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:2px 6px;font-size:9px;font-weight:700;flex:0 0 auto;margin:0!important;">
                                <i class="fa-solid fa-share"></i> Forwarded
                            </span>
                        <% } %>

                        <span
                            class="status-chip task-status-pill <%= 
                                t.is_overdue
                                    ? 'overdue'
                                    : t.status.toLowerCase().replaceAll(' ', '-')
                            %>"
                            style="flex:0 0 auto; font-size:9px; padding:2px 6px; margin:0!important;"
                        >
                            <%= t.is_overdue ? 'Overdue' : t.status %>
                        </span>

                        <% if (t.status === 'Completed' || t.status === '2') { %>
                            <% if (t.is_verified) { %>
                                <span class="status-chip verified-chip" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Verified by <%= t.verifier_name || 'Manager' %>">
                                    <i class="fa-solid fa-certificate"></i> Verified
                                </span>
                            <% } else { %>
                                <span class="status-chip awaiting-chip" style="background:#fef9c3; color:#b45309; border:1px solid #fde68a; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Awaiting Manager Verification">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                                </span>
                            <% } %>
                        <% } %>

                    </div>

                    <small style="display: block; color: #3b68b7; font-weight: 600; margin-top: 2px; font-size: 11px;">
                        <i class="fa-solid fa-folder-open" style="margin-right: 3px;"></i><%= t.project_name || 'No project' %>
                    </small>

                </div>

                <div class="entity-meta">
                    <small>Assigned By</small>
                    <b><%= Number(t.created_by) === user.id ? 'You' : t.creator_name %></b>
                </div>

                <div class="entity-meta">
                    <small>Assigned To</small>
                    <b><%= assignedIds.includes(user.id) && assignedIds.length === 1 ? 'You' : t.assigned_name %></b>
                </div>

                <div class="entity-meta">
                    <small>Assigned on</small>
                    <b><%= formatDate(t.created_at) %></b>
                </div>

                <div class="entity-meta" style="text-align: right;">
                    <small>Due date</small>
                    <b><%= formatDate(t.due_date) %></b>
                </div>

            </article>

        <% }) %>

        <% if (!tasks.length) { %>
            <p class="empty">No tasks found.</p>
        <% } %>

    </div>

</section>

        <% if (!tasks.length) { %>
            <p class="empty filter-empty">No tasks found.</p>
        <% } %>

    </div>

    <div id="task-infinite-spinner" style="text-align:center; padding: 16px 0; display: none; color: #5b5fc7; font-weight: 600; font-size: 13px;">
        <i class="fa-solid fa-spinner fa-spin" style="margin-right: 6px;"></i> Loading more tasks...
    </div>

</section>

<script>
let currentTaskPage = 1;
let isLoadingTaskBatch = false;
let hasMoreTaskBatch = <%= typeof pagination !== 'undefined' && pagination.hasMore ? 'true' : 'false' %>;
const myUserId = <%= user.id %>;

// Initialize KPI filter from URL query param if available, otherwise default to empty string (all tasks)
const initialUrlParams = new URLSearchParams(window.location.search);
if (window.currentKpiFilter === undefined) {
    window.currentKpiFilter = initialUrlParams.has('status') ? initialUrlParams.get('status').trim() : '';
}

function createTaskCardNode(t) {
    const assignedIds = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
    const isPureSelf = t.is_self_task || String(t.project_name || '').toLowerCase() === 'self task' || (Number(t.created_by) === myUserId && assignedIds.length === 1 && assignedIds[0] === myUserId);
    const isAssignedByMe = Number(t.created_by) === myUserId && !isPureSelf;
    const filterGroup = isPureSelf ? 'self' : isAssignedByMe ? 'assigned-by-me' : 'assigned-to-me';

    const article = document.createElement('article');
    article.className = `entity-card task-card ${t.is_overdue ? 'overdue-card' : ''} ${t.is_routine ? 'routine-task-card' : ''}`;
    article.dataset.status = String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-');
    article.dataset.overdue = t.is_overdue ? 'true' : 'false';
    article.dataset.forwarded = t.is_forwarded ? 'true' : 'false';
    article.dataset.project = String(t.project_name || '').toLowerCase();
    article.dataset.filterGroup = filterGroup;
    article.dataset.priority = String(t.priority || '').toLowerCase();
    article.dataset.completedAt = t.completed_at ? new Date(t.completed_at).getTime() : 0;
    article.dataset.createdAt = t.created_at ? new Date(t.created_at).getTime() : 0;
    article.dataset.id = t.id;

    const formatDateStr = (dStr) => {
        if (!dStr) return '';
        const d = new Date(dStr);
        if (isNaN(d.getTime())) return dStr;
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    };

    article.innerHTML = `
        <div class="entity-title">
            <div class="task-title-row" style="display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; overflow: hidden; width: 100%;">
                <a href="/tasks/${t.id}" style="font-weight: 800; font-size: 14px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 40px;">
                    #${t.task_number || t.id} ${t.title}
                </a>
                ${t.is_routine ? '<span class="routine-badge" style="flex:0 0 auto; margin:0!important;"><i class="fa-solid fa-repeat"></i> Routine</span>' : ''}
                ${isPureSelf ? `
                    <span class="status-chip self-task" style="background:#e0e7ff;color:#4338ca;border:1px solid #c7d2fe;padding:2px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;margin:0!important;">
                        <i class="fa-solid fa-user-check"></i> Self Task
                    </span>
                ` : ''}
                <span class="priority-pill ${(t.priority || 'Medium').toLowerCase()}" style="font-weight:700; font-size:9px; padding:2px 6px; border-radius:99px; flex:0 0 auto; margin:0!important;">
                    <i class="fa-solid fa-flag"></i> ${t.priority || 'Medium'}
                </span>
                ${t.is_forwarded ? `
                    <span class="status-chip forwarded" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:2px 6px;font-size:9px;font-weight:700;flex:0 0 auto;margin:0!important;">
                        <i class="fa-solid fa-share"></i> Forwarded
                    </span>
                ` : ''}
                <span class="status-chip task-status-pill ${t.is_overdue ? 'overdue' : String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-')}" style="flex:0 0 auto; font-size:9px; padding:2px 6px; margin:0!important;">
                    ${t.is_overdue ? 'Overdue' : t.status}
                </span>
                ${(String(t.status || '').toLowerCase() === 'completed' || String(t.status) === '2') ? (
                    t.is_verified ? `
                        <span class="status-chip verified-chip" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Verified by ${t.verifier_name || 'Manager'}">
                            <i class="fa-solid fa-certificate"></i> Verified
                        </span>
                    ` : `
                        <span class="status-chip awaiting-chip" style="background:#fef9c3; color:#b45309; border:1px solid #fde68a; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Awaiting Manager Verification">
                            <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                        </span>
                    `
                ) : ''}
            </div>
            <small style="display: block; color: #3b68b7; font-weight: 600; margin-top: 2px; font-size: 11px;">
                <i class="fa-solid fa-folder-open" style="margin-right: 3px;"></i>${t.project_name || 'No project'}
            </small>
        </div>
        <div class="entity-meta">
            <small>Assigned By</small>
            <b>${Number(t.created_by) === myUserId ? 'You' : (t.creator_name || 'Manager')}</b>
        </div>
        <div class="entity-meta">
            <small>Assigned To</small>
            <b>${assignedIds.includes(myUserId) && assignedIds.length === 1 ? 'You' : (t.assigned_name || 'You')}</b>
        </div>
        <div class="entity-meta">
            <small>Assigned on</small>
            <b>${formatDateStr(t.created_at)}</b>
        </div>
        <div class="entity-meta" style="text-align: right;">
            <small>Due date</small>
            <b>${formatDateStr(t.due_date)}</b>
        </div>
    `;

    article.addEventListener('click', event => {
        if (event.target.closest('a,button,input,select,form')) return;
        location.href = `/tasks/${t.id}`;
    });

    return article;
}

let activeTaskFetchController = null;

async function fetchNextTaskBatch(isReset = false) {
    if (!isReset && isLoadingTaskBatch) return;
    if (!isReset && !hasMoreTaskBatch) return;

    if (isReset) {
        if (activeTaskFetchController) {
            try { activeTaskFetchController.abort(); } catch(e) {}
        }
        currentTaskPage = 1;
        hasMoreTaskBatch = true;
        isLoadingTaskBatch = false;
    } else {
        currentTaskPage++;
    }

    activeTaskFetchController = new AbortController();
    const currentFetchController = activeTaskFetchController;
    isLoadingTaskBatch = true;
    const spinner = document.getElementById('task-infinite-spinner');
    if (spinner) spinner.style.display = 'block';

    const activeKpi = window.currentKpiFilter !== undefined && window.currentKpiFilter !== null ? window.currentKpiFilter : '';
    const bar = document.querySelector('.compact-filter');
    const searchInput = bar ? bar.querySelector('input[type="search"]') : null;
    const queryVal = searchInput ? searchInput.value.trim() : '';
    const projectSelect = bar ? bar.querySelector('select') : null;
    const projectVal = projectSelect ? projectSelect.value.trim() : '';
    const activeTabBtn = document.querySelector('.task-tab-btn.active');
    const tabVal = activeTabBtn ? activeTabBtn.getAttribute('data-task-tab') : 'assigned-to-me';

    const params = new URLSearchParams({
        page: currentTaskPage,
        limit: 20,
        status: activeKpi,
        q: queryVal,
        project: projectVal,
        task_tab: tabVal
    });

    try {
        const res = await fetch(`/tasks/api/list?${params.toString()}`, {
            signal: currentFetchController.signal
        });
        const data = await res.json();
        if (data.success) {
            const container = document.querySelector('.entity-list');
            if (container) {
                if (isReset) {
                    container.querySelectorAll('.task-card').forEach(el => el.remove());
                }

                if (data.tasks && data.tasks.length > 0) {
                    data.tasks.forEach(t => {
                        const cardNode = createTaskCardNode(t);
                        container.appendChild(cardNode);
                    });
                }

                const emptyMsg = container.querySelector('.filter-empty, .empty');
                if (emptyMsg) {
                    const totalCards = container.querySelectorAll('.task-card').length;
                    emptyMsg.style.display = (totalCards === 0) ? 'block' : 'none';
                }
            }

            hasMoreTaskBatch = data.pagination ? data.pagination.hasMore : false;
        }
    } catch (err) {
        if (err.name === 'AbortError') return;
        console.error('Error fetching task batch:', err);
    } finally {
        if (activeTaskFetchController === currentFetchController) {
            isLoadingTaskBatch = false;
            if (spinner) spinner.style.display = 'none';

            // Auto-fill screen if content is shorter than viewport and more pages exist
            if (hasMoreTaskBatch && document.documentElement.scrollHeight <= window.innerHeight + 150) {
                setTimeout(() => {
                    if (!isLoadingTaskBatch && hasMoreTaskBatch) {
                        fetchNextTaskBatch(false);
                    }
                }, 250);
            }
        }
    }
}
window.fetchNextTaskBatch = fetchNextTaskBatch;

window.filterTaskType = function(type, btn) {
    document.querySelectorAll('.task-tab-btn').forEach(b => {
        b.classList.remove('active');
    });
    if (btn) {
        btn.classList.add('active');
    }
    fetchNextTaskBatch(true);
};

window.filterByKpi = function(filterVal, event) {
    try {
        const valStr = String(filterVal || '').toLowerCase().trim();
        window.currentKpiFilter = valStr;

        document.querySelectorAll('.metric-card').forEach(card => {
            card.classList.remove('active-kpi-filter');
        });

        let targetCard = null;
        if (event && event.currentTarget) {
            targetCard = event.currentTarget.closest('.metric-card');
        }
        if (!targetCard) {
            document.querySelectorAll('.metric-card').forEach(card => {
                const onclickAttr = (card.getAttribute('onclick') || '').toLowerCase();
                if (onclickAttr.includes(`'${valStr}'`) || onclickAttr.includes(`"${valStr}"`)) {
                    targetCard = card;
                }
            });
        }
        if (targetCard) {
            targetCard.classList.add('active-kpi-filter');
        }
    } catch(e) {
        console.error("filterByKpi ui update error:", e);
    } finally {
        fetchNextTaskBatch(true);
    }
};

let filterTimeout = null;
document.addEventListener('input', function(e) {
    if (e.target.matches('.compact-filter input')) {
        clearTimeout(filterTimeout);
        filterTimeout = setTimeout(() => {
            fetchNextTaskBatch(true);
        }, 300);
    }
});

document.addEventListener('change', function(e) {
    if (e.target.matches('.compact-filter select')) {
        fetchNextTaskBatch(true);
    }
});

window.addEventListener('scroll', function() {
    if (isLoadingTaskBatch || !hasMoreTaskBatch) return;
    const scrollPos = window.innerHeight + window.scrollY;
    const threshold = document.documentElement.scrollHeight - 200;
    if (scrollPos >= threshold) {
        fetchNextTaskBatch(false);
    }
});

document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('error') === 'deleted') {
        const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
        if (cancelBtn) cancelBtn.style.display = 'none';
        
        if (window.showConfirmDialog) {
            window.showConfirmDialog({
                title: 'Task Deleted',
                message: 'Task was deleted',
                confirmText: 'OK',
                danger: true
            }).then(() => {
                if (cancelBtn) cancelBtn.style.display = '';
            });
        } else {
            alert('Task was deleted');
        }
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({path: cleanUrl}, '', cleanUrl);
    }

    // Auto check if initial load needs auto-filling for high resolution screens
    if (hasMoreTaskBatch && document.documentElement.scrollHeight <= window.innerHeight + 150) {
        setTimeout(() => {
            if (!isLoadingTaskBatch && hasMoreTaskBatch) {
                // Remove immediate page 2 fetch on load to prevent racing with KPI initial clicks
                // fetchNextTaskBatch(false);
            }
        }, 300);
    }
});
</script>


