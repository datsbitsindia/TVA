<%- include('partials/head', { title: 'Tasks' }) %>
<%- include('partials/nav', { page: 'tasks' }) %>

<%
    const done = tasks.filter(
        t => String(t.status).toLowerCase() === 'completed'
    ).length;

    const pending = tasks.filter(
        t => String(t.status).toLowerCase() === 'pending'
    ).length;

    const progress = tasks.filter(
        t => String(t.status).toLowerCase() === 'in progress'
    ).length;

    const overdueCount = tasks.filter(t => t.is_overdue).length;
%>

<div class="metric-grid task-kpis five">

    <div class="metric-card red" onclick="filterByKpi('Overdue', event)" title="Click to filter Overdue tasks">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <b><%= overdueCount %></b>
        <span>Overdue</span>
    </div>

    <div class="metric-card orange" onclick="filterByKpi('Pending', event)" title="Click to filter Pending tasks">
        <i class="fa-regular fa-clock"></i>
        <b><%= pending %></b>
        <span>Pending</span>
    </div>

    <div class="metric-card purple" onclick="filterByKpi('In Progress', event)" title="Click to filter In Progress tasks">
        <i class="fa-solid fa-spinner"></i>
        <b><%= progress %></b>
        <span>In Progress</span>
    </div>

    <div class="metric-card green" onclick="filterByKpi('Completed', event)" title="Click to filter Completed tasks">
        <i class="fa-regular fa-circle-check"></i>
        <b><%= done %></b>
        <span>Completed</span>
    </div>

    <div class="metric-card" onclick="filterByKpi('all', event)" title="Click to show all tasks">
        <i class="fa-solid fa-list-check"></i>
        <b><%= tasks.length %></b>
        <span>Total Tasks</span>
    </div>

</div>

<%
    const overdueTasks = tasks.filter(t => t.is_overdue);
    const routineTasksToday = tasks.filter(t => t.is_routine && String(t.status).toLowerCase() !== 'completed');
%>

<% if (user.role === 'manager' && typeof dailyRoutines !== 'undefined' && dailyRoutines.length) { %>
    <section class="ui-panel routine-panel">
        <div class="ui-panel-head">
            <h2><i class="fa-solid fa-repeat" style="color: #5b5fc7;"></i> Active Daily Routines (Timeline Schedules)</h2>
            <span class="muted"><%= dailyRoutines.length %> schedule<%= dailyRoutines.length > 1 ? 's' : '' %></span>
        </div>
        <div class="routine-grid">
            <% dailyRoutines.forEach(r => { %>
                <article class="routine-card">
                    <div class="routine-card-top">
                        <div class="routine-card-info">
                            <b><%= r.title %></b>
                            <small>#<%= r.id %> <%= r.project_name %> · <%= (r.description || '').replace(/<[^>]*>?/gm, '').trim() || 'Daily routine task' %></small>

                        </div>
                        <span class="status-chip <%= r.active ? 'in-progress' : 'cancelled' %>">
                            <%= r.active ? 'Active' : 'Paused' %>
                        </span>
                    </div>

                    <div class="routine-card-meta">
                        <div>
                            <small>Assigned To</small>
                            <b><%= r.assigned_name %></b>
                        </div>
                        <div>
                            <small>Timeline</small>
                            <b><%= formatDate(r.start_date) %> ➔ <%= formatDate(r.end_date) %></b>
                        </div>
                        <div>
                            <small>Daily Time</small>
                            <b><i class="fa-regular fa-clock"></i> <%= r.daily_time %></b>
                        </div>
                    </div>

                    <div class="routine-card-actions">
                        <form action="/tasks/routine/<%= r.id %>/toggle" method="POST" style="display:inline;">
                            <button class="btn btn-sm <%= r.active ? 'secondary' : 'primary' %>" title="<%= r.active ? 'Pause Routine' : 'Activate Routine' %>">
                                <i class="fa-solid <%= r.active ? 'fa-pause' : 'fa-play' %>"></i> <%= r.active ? 'Pause' : 'Activate' %>
                            </button>
                        </form>
                        <form action="/tasks/routine/<%= r.id %>/delete" method="POST" style="display:inline;" data-confirm="Delete this routine schedule?">
                            <button class="btn btn-sm danger-btn" title="Delete Routine">
                                <i class="fa-solid fa-trash"></i> Delete
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
<% } %>

<% if (user.role === 'employee' && routineTasksToday.length) { %>
    <div class="routine-alert-banner">
        <div class="routine-alert-head">
            <i class="fa-solid fa-sun icon-sun"></i>
            <div>
                <h3><i class="fa-solid fa-clock-rotate-left"></i> Today's Daily Routine (Must Complete First)</h3>
                <p>Please complete your assigned daily routine tasks before starting other regular tasks.</p>
            </div>
        </div>
        <div class="routine-card-grid">
            <% routineTasksToday.forEach(rt => { %>
                <div class="routine-highlight-card">
                    <div class="routine-card-header">
                        <span class="routine-badge"><i class="fa-solid fa-repeat"></i> Daily Routine</span>
                        <span class="status-chip <%= rt.status.toLowerCase().replaceAll(' ', '-') %>"><%= rt.status %></span>
                    </div>
                    <h4><a href="/tasks/<%= rt.id %>"><%= rt.title %></a></h4>
                    <p><%= rt.description || 'Complete daily morning routine' %></p>
                    <div class="routine-card-footer">
                        <small><i class="fa-solid fa-folder"></i> #<%= rt.task_number || rt.id %> <%= rt.project_name || 'Project' %></small>
                        <a href="/tasks/<%= rt.id %>" class="btn btn-sm primary">Start / Complete</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
<% } %>

<% if (overdueTasks.length) { %>
    <div class="overdue-alert">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <b>
                <%= overdueTasks.length %>
                overdue task<%= overdueTasks.length > 1 ? 's' : '' %>
            </b>
            <span>
                <%= user.role === 'manager'
                    ? 'Employee tasks are overdue. Please follow up urgently.'
                    : 'Due date has passed. Please complete the task urgently.'
                %>
            </span>
        </div>
    </div>
<% } %>

<%
    const myId = user.id;
    const assignedToMeTasks = tasks.filter(t => {
        const ids = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
        return ids.includes(myId);
    });

    const assignedByMeTasks = tasks.filter(t => {
        const ids = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
        return Number(t.created_by) === myId && !ids.every(id => id === myId);
    });
%>

<section class="ui-panel">

    <div class="task-type-tabs-container" style="display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 8px !important; margin-bottom: 12px !important;">
        <button type="button" class="btn task-tab-btn active" data-task-tab="assigned-to-me" onclick="filterTaskType('assigned-to-me', this)">
            <i class="fa-solid fa-inbox"></i> To Do
        </button>
        <button type="button" class="btn task-tab-btn" data-task-tab="assigned-by-me" onclick="filterTaskType('assigned-by-me', this)">
            <i class="fa-solid fa-paper-plane"></i> Assigned
        </button>
    </div>



    <div class="toolbar-ui compact-filter" style="margin-bottom: 16px;">
        <input
            type="search"
            placeholder="Search tasks..."
            oninput="applyCompactFilter(this.closest('.compact-filter'))"
        >

        <select onchange="applyCompactFilter(this.closest('.compact-filter'))">
            <option>All Projects</option>
            <% projects.forEach(p => { %>
                <option><%= p.name %></option>
            <% }) %>
        </select>
    </div>

    <div class="entity-list">

        <% tasks.forEach(t => { %>
            <%
                const assignedIds = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
                const isPureSelf = t.is_self_task || String(t.project_name).toLowerCase() === 'self task' || (Number(t.created_by) === user.id && assignedIds.length === 1 && assignedIds[0] === user.id);
                const isAssignedByMe = Number(t.created_by) === user.id && !isPureSelf;
                const isAssignedToMe = assignedIds.includes(user.id);
                const filterGroup = isPureSelf ? 'self' : isAssignedByMe ? 'assigned-by-me' : 'assigned-to-me';
            %>

            <article
                class="entity-card task-card <%= t.is_overdue ? 'overdue-card' : '' %> <%= t.is_routine ? 'routine-task-card' : '' %>"
                data-status="<%= String(t.status).toLowerCase().replaceAll(' ', '-') %>"
                data-overdue="<%= t.is_overdue ? 'true' : 'false' %>"
                data-forwarded="<%= t.is_forwarded ? 'true' : 'false' %>"
                data-project="<%= (t.project_name || '').toLowerCase() %>"
                data-filter-group="<%= filterGroup %>"
                data-priority="<%= (t.priority || '').toLowerCase() %>"
                data-completed-at="<%= t.completed_at ? new Date(t.completed_at).getTime() : 0 %>"
                data-created-at="<%= t.created_at ? new Date(t.created_at).getTime() : 0 %>"
                data-id="<%= t.id %>"
            >

                <div class="entity-title">

                    <div class="task-title-row" style="display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; overflow: hidden; width: 100%;">

                        <a href="/tasks/<%= t.id %>" style="font-weight: 800; font-size: 14px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 40px;">
                            #<%= t.task_number || t.id %> <%= t.title %>
                        </a>

                        <% if (t.is_routine) { %>
                            <span class="routine-badge" style="flex:0 0 auto; margin:0!important;"><i class="fa-solid fa-repeat"></i> Routine</span>
                        <% } %>

                        <% if (isPureSelf) { %>
                            <span class="status-chip self-task" style="background:#e0e7ff;color:#4338ca;border:1px solid #c7d2fe;padding:2px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;margin:0!important;">
                                <i class="fa-solid fa-user-check"></i> Self Task
                            </span>
                        <% } %>

                        <span class="priority-pill <%= t.priority.toLowerCase() %>" style="font-weight:700; font-size:9px; padding:2px 6px; border-radius:99px; flex:0 0 auto; margin:0!important;">
                            <i class="fa-solid fa-flag"></i> <%= t.priority %>
                        </span>

                        <% if (t.is_forwarded) { %>
                            <span class="status-chip forwarded" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:2px 6px;font-size:9px;font-weight:700;flex:0 0 auto;margin:0!important;">
                                <i class="fa-solid fa-share"></i> Forwarded
                            </span>
                        <% } %>

                        <span
                            class="status-chip task-status-pill <%= 
                                t.is_overdue
                                    ? 'overdue'
                                    : t.status.toLowerCase().replaceAll(' ', '-')
                            %>"
                            style="flex:0 0 auto; font-size:9px; padding:2px 6px; margin:0!important;"
                        >
                            <%= t.is_overdue ? 'Overdue' : t.status %>
                        </span>

                        <% if (t.status === 'Completed' || t.status === '2') { %>
                            <% if (t.is_verified) { %>
                                <span class="status-chip verified-chip" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Verified by <%= t.verifier_name || 'Manager' %>">
                                    <i class="fa-solid fa-certificate"></i> Verified
                                </span>
                            <% } else { %>
                                <span class="status-chip awaiting-chip" style="background:#fef9c3; color:#b45309; border:1px solid #fde68a; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Awaiting Manager Verification">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                                </span>
                            <% } %>
                        <% } %>

                    </div>

                    <small style="display: block; color: #3b68b7; font-weight: 600; margin-top: 2px; font-size: 11px;">
                        <i class="fa-solid fa-folder-open" style="margin-right: 3px;"></i><%= t.project_name || 'No project' %>
                    </small>

                </div>

                <div class="entity-meta">
                    <small>Assigned By</small>
                    <b><%= Number(t.created_by) === user.id ? 'You' : t.creator_name %></b>
                </div>

                <div class="entity-meta">
                    <small>Assigned To</small>
                    <b><%= assignedIds.includes(user.id) && assignedIds.length === 1 ? 'You' : t.assigned_name %></b>
                </div>

                <div class="entity-meta">
                    <small>Assigned on</small>
                    <b><%= formatDate(t.created_at) %></b>
                </div>

                <div class="entity-meta" style="text-align: right;">
                    <small>Due date</small>
                    <b><%= formatDate(t.due_date) %></b>
                </div>

            </article>

        <% }) %>

        <% if (!tasks.length) { %>
            <p class="empty">No tasks found.</p>
        <% } %>

    </div>

</section>

<script>
window.filterTaskType = function(type, btn) {
    document.querySelectorAll('.task-tab-btn').forEach(b => {
        b.classList.remove('active');
    });
    if (btn) {
        btn.classList.add('active');
    }
    const bar = document.querySelector('.compact-filter');
    if (bar && window.applyCompactFilter) {
        window.applyCompactFilter(bar);
    }
};

document.addEventListener('DOMContentLoaded', function() {
    setTimeout(function() {
        const params = new URLSearchParams(window.location.search);
        const statusParam = params.get('status');
        if (window.filterByKpi) {
            window.filterByKpi(statusParam || 'Pending');
        }
    }, 50);

    const params = new URLSearchParams(window.location.search);
    if (params.get('error') === 'deleted') {
        const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
        if (cancelBtn) cancelBtn.style.display = 'none';
        
        if (window.showConfirmDialog) {
            window.showConfirmDialog({
                title: 'Task Deleted',
                message: 'Task was deleted',
                confirmText: 'OK',
                danger: true
            }).then(() => {
                if (cancelBtn) cancelBtn.style.display = '';
            });
        } else {
            alert('Task was deleted');
        }
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({path: cleanUrl}, '', cleanUrl);
    }
});
</script>


<%- include('partials/task-modal') %>

<%- include('partials/foot') %>