</style>

    <div class="entity-list">

        <% tasks.forEach(t => { %>
            <%
                const assignedIds = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
                const isPureSelf = t.is_self_task || String(t.project_name).toLowerCase() === 'self task' || (Number(t.created_by) === user.id && assignedIds.length === 1 && assignedIds[0] === user.id);
                const isAssignedByMe = Number(t.created_by) === user.id && !isPureSelf;
                const isAssignedToMe = assignedIds.includes(user.id);
                const filterGroup = isPureSelf ? 'self' : isAssignedByMe ? 'assigned-by-me' : 'assigned-to-me';
                const byName = Number(t.created_by) === user.id ? 'You' : t.creator_name;
                const toName = assignedIds.includes(user.id) && assignedIds.length === 1 ? 'You' : t.assigned_name;
            %>

            <article
                class="entity-card task-card <%= t.is_overdue ? 'overdue-card' : '' %> <%= t.is_routine ? 'routine-task-card' : '' %>"
                data-status="<%= String(t.status).toLowerCase().replaceAll(' ', '-') %>"
                data-overdue="<%= t.is_overdue ? 'true' : 'false' %>"
                data-forwarded="<%= t.is_forwarded ? 'true' : 'false' %>"
                data-project="<%= (t.project_name || '').toLowerCase() %>"
                data-filter-group="<%= filterGroup %>"
                data-priority="<%= (t.priority || '').toLowerCase() %>"
                data-completed-at="<%= t.completed_at ? new Date(t.completed_at).getTime() : 0 %>"
                data-created-at="<%= t.created_at ? new Date(t.created_at).getTime() : 0 %>"
                data-id="<%= t.id %>"
            >

                <!-- DESKTOP / IPAD VIEW (min-width: 769px) -->
                <div class="tc-desktop-view">
                    <!-- 1: Task number centered -->
                    <div class="tc-desk-left-col">
                        <span class="tc-desk-num">#<%= t.task_number || t.id %></span>
                    </div>

                    <!-- 2: Task title on top, Project row below, Metadata -->
                    <div class="tc-desk-body">
                        <!-- Line 1: Task title on top with badges -->
                        <div class="tc-desk-title-row">
                            <a href="/tasks/<%= t.id %>" class="tc-desk-title">
                                <%= t.title %>
                            </a>

                            <% if (t.is_routine) { %>
                                <span class="routine-badge"><i class="fa-solid fa-repeat"></i> Routine</span>
                            <% } %>

                            <% if (isPureSelf) { %>
                                <span class="status-chip self-task">
                                    <i class="fa-solid fa-user-check"></i> Self Task
                                </span>
                            <% } %>

                            <% if (t.is_forwarded) { %>
                                <span class="status-chip forwarded">
                                    <i class="fa-solid fa-share"></i> Forwarded
                                </span>
                            <% } %>

                            <% if (t.status === 'Completed' || t.status === '2') { %>
                                <% if (t.is_verified) { %>
                                    <span class="status-chip verified-chip" title="Verified by <%= t.verifier_name || 'Manager' %>">
                                        <i class="fa-solid fa-certificate"></i> Verified
                                    </span>
                                <% } else { %>
                                    <span class="status-chip awaiting-chip" title="Awaiting Manager Verification">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                                    </span>
                                <% } %>
                            <% } %>
                        </div>

                        <!-- Line 2: Folder icon + project name in distinct color -->
                        <div class="tc-desk-proj-row">
                            <span class="tc-desk-project-tag">
                                <i class="fa-solid fa-folder-open"></i> <%= t.project_name || 'No project' %>
                            </span>
                        </div>

                        <!-- 3: By: ..., To: ..., On: ..., Due: ... all on one line -->
                        <div class="tc-desk-meta-row">
                            <span class="tc-meta-item tc-meta-by"><span class="tc-lbl">By:</span> <span class="tc-val"><%= byName %></span></span>
                            <span class="tc-meta-item tc-meta-to" title="<%= toName %>"><span class="tc-lbl">To:</span> <span class="tc-val"><%= toName %></span></span>
                            <span class="tc-meta-item tc-meta-on"><span class="tc-lbl">On:</span> <span class="tc-val"><%= formatDate(t.created_at) %></span></span>
                            <span class="tc-meta-item tc-meta-due"><span class="tc-lbl">Due:</span> <span class="tc-val"><%= formatDate(t.due_date) %></span></span>
                        </div>
                    </div>

                    <!-- Right side: Priority badge & Status chip -->
                    <div class="tc-desktop-right tc-desk-right">
                        <span class="tc-priority-pill <%= (t.priority || 'medium').toLowerCase() %>">
                            <%= (t.priority || 'Medium').toUpperCase() %>
                        </span>
                        <span class="status-chip task-status-pill <%= t.is_overdue ? 'overdue' : String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-') %>">
                            <%= t.is_overdue ? 'Overdue' : t.status %>
                        </span>
                    </div>
                </div>

                <!-- MOBILE VIEW (max-width: 768px): ORIGINAL MOBILE LAYOUT -->
                <div class="tc-mobile-view">
                    <div class="entity-title">
                        <div class="task-title-row" style="display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; overflow: hidden; width: 100%;">
                            <a href="/tasks/<%= t.id %>" style="font-weight: 800; font-size: 14px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 40px;">
                                <%= t.title %>
                            </a>

                            <% if (t.is_routine) { %>
                                <span class="routine-badge" style="flex:0 0 auto; margin:0!important;"><i class="fa-solid fa-repeat"></i> Routine</span>
                            <% } %>

                            <% if (isPureSelf) { %>
                                <span class="status-chip self-task" style="background:#e0e7ff;color:#4338ca;border:1px solid #c7d2fe;padding:2px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;margin:0!important;">
                                    <i class="fa-solid fa-user-check"></i> Self Task
                                </span>
                            <% } %>

                            <span class="priority-pill <%= t.priority.toLowerCase() %>" style="font-weight:700; font-size:9px; padding:2px 6px; border-radius:99px; flex:0 0 auto; margin:0!important;">
                                <i class="fa-solid fa-flag"></i> <%= t.priority %>
                            </span>

                            <% if (t.is_forwarded) { %>
                                <span class="status-chip forwarded" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:2px 6px;font-size:9px;font-weight:700;flex:0 0 auto;margin:0!important;">
                                    <i class="fa-solid fa-share"></i> Forwarded
                                </span>
                            <% } %>

                            <span
                                class="status-chip task-status-pill <%= 
                                    t.is_overdue
                                        ? 'overdue'
                                        : t.status.toLowerCase().replaceAll(' ', '-')
                                %>"
                                style="flex:0 0 auto; font-size:9px; padding:2px 6px; margin:0!important;"
                            >
                                <%= t.is_overdue ? 'Overdue' : t.status %>
                            </span>

                            <% if (t.status === 'Completed' || t.status === '2') { %>
                                <% if (t.is_verified) { %>
                                    <span class="status-chip verified-chip" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Verified by <%= t.verifier_name || 'Manager' %>">
                                        <i class="fa-solid fa-certificate"></i> Verified
                                    </span>
                                <% } else { %>
                                    <span class="status-chip awaiting-chip" style="background:#fef9c3; color:#b45309; border:1px solid #fde68a; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Awaiting Manager Verification">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                                    </span>
                                <% } %>
                            <% } %>
                        </div>

                        <small style="display: flex; align-items: center; gap: 6px; color: #3b68b7; font-weight: 600; margin-top: 2px; font-size: 11px; flex-wrap: wrap;">
                            <span><i class="fa-solid fa-folder-open" style="margin-right: 3px;"></i><%= t.project_name || 'No project' %></span>
                            <span style="color: #64748b; font-weight: 700;">#<%= t.task_number || t.id %></span>
                        </small>
                    </div>

                    <div class="entity-meta">
                        <small>Assigned By</small>
                        <b><%= formatShortName(byName) %></b>
                    </div>

                    <div class="entity-meta">
                        <small>Assigned To</small>
                        <b><%= formatShortName(toName) %></b>
                    </div>

                    <div class="entity-meta">
                        <small>Assigned on</small>
                        <b><%= formatDate(t.created_at) %></b>
                    </div>

                    <div class="entity-meta" style="text-align: right;">
                        <small>Due date</small>
                        <b><%= formatDate(t.due_date) %></b>
                    </div>
                </div>

            </article>

        <% }) %>

        <p class="empty filter-empty" style="<%= tasks.length ? 'display: none;' : '' %>">No tasks found.</p>

    </div>

    <div id="task-infinite-spinner" style="text-align:center; padding: 16px 0; display: none; color: #5b5fc7; font-weight: 600; font-size: 13px;">
        <i class="fa-solid fa-spinner fa-spin" style="margin-right: 6px;"></i> Loading more tasks...
    </div>

</section>

<script>
let currentTaskPage = 1;
let isLoadingTaskBatch = false;
let hasMoreTaskBatch = <%= typeof pagination !== 'undefined' && pagination.hasMore ? 'true' : 'false' %>;
const myUserId = <%= user.id %>;

// Initialize KPI filter from URL query param if available, otherwise default to empty string (all tasks)
const initialUrlParams = new URLSearchParams(window.location.search);
if (window.currentKpiFilter === undefined) {
    window.currentKpiFilter = initialUrlParams.has('status') ? initialUrlParams.get('status').trim() : 'pending';
}

function formatShortName(nameStr) {
    if (!nameStr) return '';
    const str = String(nameStr).trim();
    if (!str) return '';
    return str.split(',').map(part => {
        const item = part.trim();
        if (!item || item.toLowerCase() === 'you') return item;
        const words = item.split(/\s+/).filter(Boolean);
        if (words.length <= 1) return item;
        return words[0] + ' ' + words[1].charAt(0);
    }).join(', ');
}

function createTaskCardNode(t) {
    const assignedIds = String(t.assigned_to || '').split(',').map(x => Number(x.trim()));
    const isPureSelf = t.is_self_task || String(t.project_name || '').toLowerCase() === 'self task' || (Number(t.created_by) === myUserId && assignedIds.length === 1 && assignedIds[0] === myUserId);
    const hasProject = t.project_name && !['no project', 'self task', 'none', ''].includes(String(t.project_name).toLowerCase().trim()) && !isPureSelf && !t.is_self_task;
    const isAssignedByMe = Number(t.created_by) === myUserId && !isPureSelf;
    const filterGroup = isPureSelf ? 'self' : isAssignedByMe ? 'assigned-by-me' : 'assigned-to-me';

    const byName = Number(t.created_by) === myUserId ? 'You' : (t.creator_name || 'Manager');
    const toName = assignedIds.includes(myUserId) && assignedIds.length === 1 ? 'You' : (t.assigned_name || 'You');
    const projName = t.project_name || 'No project';
    const isEmptyProj = !t.project_name || String(t.project_name).toLowerCase().trim() === 'no project';
    const taskNum = t.task_number || t.id;

    const article = document.createElement('article');
    article.className = `entity-card task-card ${t.is_overdue ? 'overdue-card' : ''} ${t.is_routine ? 'routine-task-card' : ''}`;
    article.dataset.status = String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-');
    article.dataset.overdue = t.is_overdue ? 'true' : 'false';
    article.dataset.forwarded = t.is_forwarded ? 'true' : 'false';
    article.dataset.project = String(t.project_name || '').toLowerCase();
    article.dataset.filterGroup = filterGroup;
    article.dataset.priority = String(t.priority || '').toLowerCase();
    article.dataset.completedAt = t.completed_at ? new Date(t.completed_at).getTime() : 0;
    article.dataset.createdAt = t.created_at ? new Date(t.created_at).getTime() : 0;
    article.dataset.id = t.id;

    const formatDateStr = (dStr) => {
        if (!dStr) return '';
        const d = new Date(dStr);
        if (isNaN(d.getTime())) return dStr;
        return d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
    };

    article.innerHTML = `
        <!-- DESKTOP / IPAD VIEW (min-width: 769px) -->
        <div class="tc-desktop-view">
            <!-- 1: Task number centered -->
            <div class="tc-desk-left-col">
                <span class="tc-desk-num">#${taskNum}</span>
            </div>

            <!-- 2: Task title on top, Project row below, Metadata -->
            <div class="tc-desk-body">
                <!-- Line 1: Task title on top with badges -->
                <div class="tc-desk-title-row">
                    <a href="/tasks/${t.id}" class="tc-desk-title">
                        ${escapeHtml(t.title)}
                    </a>

                    ${t.is_routine ? '<span class="routine-badge"><i class="fa-solid fa-repeat"></i> Routine</span>' : ''}
                    ${isPureSelf ? `
                        <span class="status-chip self-task">
                            <i class="fa-solid fa-user-check"></i> Self Task
                        </span>
                    ` : ''}
                    ${t.is_forwarded ? `
                        <span class="status-chip forwarded">
                            <i class="fa-solid fa-share"></i> Forwarded
                        </span>
                    ` : ''}
                    ${(String(t.status || '').toLowerCase() === 'completed' || String(t.status) === '2') ? (
                        t.is_verified ? `
                            <span class="status-chip verified-chip" title="Verified by ${escapeHtml(t.verifier_name || 'Manager')}">
                                <i class="fa-solid fa-certificate"></i> Verified
                            </span>
                        ` : `
                            <span class="status-chip awaiting-chip" title="Awaiting Manager Verification">
                                <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                            </span>
                        `
                    ) : ''}
                </div>

                <!-- Line 2: Folder icon + project name in distinct color -->
                <div class="tc-desk-proj-row">
                    <span class="tc-desk-project-tag">
                        <i class="fa-solid fa-folder-open"></i> ${escapeHtml(projName)}
                    </span>
                </div>

                <!-- 3: By: ..., To: ..., On: ..., Due: ... all on one line -->
                <div class="tc-desk-meta-row">
                    <span class="tc-meta-item tc-meta-by"><span class="tc-lbl">By:</span> <span class="tc-val">${escapeHtml(byName)}</span></span>
                    <span class="tc-meta-item tc-meta-to" title="${escapeHtml(toName)}"><span class="tc-lbl">To:</span> <span class="tc-val">${escapeHtml(toName)}</span></span>
                    <span class="tc-meta-item tc-meta-on"><span class="tc-lbl">On:</span> <span class="tc-val">${formatDateStr(t.created_at)}</span></span>
                    <span class="tc-meta-item tc-meta-due"><span class="tc-lbl">Due:</span> <span class="tc-val">${formatDateStr(t.due_date)}</span></span>
                </div>
            </div>

            <!-- Right side: Priority badge & Status chip -->
            <div class="tc-desktop-right tc-desk-right">
                <span class="tc-priority-pill ${(t.priority || 'medium').toLowerCase()}">
                    ${String(t.priority || 'Medium').toUpperCase()}
                </span>
                <span class="status-chip task-status-pill ${t.is_overdue ? 'overdue' : String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-')}">
                    ${t.is_overdue ? 'Overdue' : escapeHtml(t.status)}
                </span>
            </div>
        </div>

        <!-- MOBILE VIEW (max-width: 768px): ORIGINAL MOBILE LAYOUT -->
        <div class="tc-mobile-view">
            <div class="entity-title">
                <div class="task-title-row" style="display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; overflow: hidden; width: 100%;">
                    <a href="/tasks/${t.id}" style="font-weight: 800; font-size: 14px; color: #0f172a; text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1 1 auto; min-width: 40px;">
                        ${escapeHtml(t.title)}
                    </a>

                    ${t.is_routine ? '<span class="routine-badge" style="flex:0 0 auto; margin:0!important;"><i class="fa-solid fa-repeat"></i> Routine</span>' : ''}

                    ${isPureSelf ? `
                        <span class="status-chip self-task" style="background:#e0e7ff;color:#4338ca;border:1px solid #c7d2fe;padding:2px 6px;font-size:9px;font-weight:700;display:inline-flex;align-items:center;gap:3px;flex:0 0 auto;margin:0!important;">
                            <i class="fa-solid fa-user-check"></i> Self Task
                        </span>
                    ` : ''}

                    <span class="priority-pill ${(t.priority || 'medium').toLowerCase()}" style="font-weight:700; font-size:9px; padding:2px 6px; border-radius:99px; flex:0 0 auto; margin:0!important;">
                        <i class="fa-solid fa-flag"></i> ${escapeHtml(t.priority || 'Medium')}
                    </span>

                    ${t.is_forwarded ? `
                        <span class="status-chip forwarded" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:2px 6px;font-size:9px;font-weight:700;flex:0 0 auto;margin:0!important;">
                            <i class="fa-solid fa-share"></i> Forwarded
                        </span>
                    ` : ''}

                    <span
                        class="status-chip task-status-pill ${t.is_overdue ? 'overdue' : String(t.status || 'Pending').toLowerCase().replaceAll(' ', '-')}"
                        style="flex:0 0 auto; font-size:9px; padding:2px 6px; margin:0!important;"
                    >
                        ${t.is_overdue ? 'Overdue' : escapeHtml(t.status)}
                    </span>

                    ${(String(t.status || '').toLowerCase() === 'completed' || String(t.status) === '2') ? (
                        t.is_verified ? `
                            <span class="status-chip verified-chip" style="background:#dcfce7; color:#15803d; border:1px solid #bbf7d0; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Verified by ${escapeHtml(t.verifier_name || 'Manager')}">
                                <i class="fa-solid fa-certificate"></i> Verified
                            </span>
                        ` : `
                            <span class="status-chip awaiting-chip" style="background:#fef9c3; color:#b45309; border:1px solid #fde68a; padding:2px 6px; font-size:9px; font-weight:700; flex:0 0 auto; margin:0!important;" title="Awaiting Manager Verification">
                                <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                            </span>
                        `
                    ) : ''}
                </div>

                <small style="display: flex; align-items: center; gap: 6px; color: #3b68b7; font-weight: 600; margin-top: 2px; font-size: 11px; flex-wrap: wrap;">
                    <span><i class="fa-solid fa-folder-open" style="margin-right: 3px;"></i>${escapeHtml(projName)}</span>
                    <span style="color: #64748b; font-weight: 700;">#${taskNum}</span>
                </small>
            </div>

            <div class="entity-meta">
                <small>Assigned By</small>
                <b>${escapeHtml(formatShortName(byName))}</b>
            </div>

            <div class="entity-meta">
                <small>Assigned To</small>
                <b>${escapeHtml(formatShortName(toName))}</b>
            </div>

            <div class="entity-meta">
                <small>Assigned on</small>
                <b>${formatDateStr(t.created_at)}</b>
            </div>

            <div class="entity-meta" style="text-align: right;">
                <small>Due date</small>
                <b>${formatDateStr(t.due_date)}</b>
            </div>
        </div>
    `;

    article.addEventListener('click', event => {
        if (event.target.closest('a,button,input,select,form')) return;
        location.href = `/tasks/${t.id}`;
    });

    return article;
}

let activeTaskFetchController = null;

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

async function fetchNextTaskBatch(isReset = false) {
    if (!isReset && isLoadingTaskBatch) return;
    if (!isReset && !hasMoreTaskBatch) return;

    if (isReset) {
        if (activeTaskFetchController) {
            try { activeTaskFetchController.abort(); } catch(e) {}
        }
        hasMoreTaskBatch = true;
        isLoadingTaskBatch = false;
    }

    const targetPage = isReset ? 1 : currentTaskPage + 1;

    activeTaskFetchController = new AbortController();
    const currentFetchController = activeTaskFetchController;
    isLoadingTaskBatch = true;
    const spinner = document.getElementById('task-infinite-spinner');
    if (spinner) spinner.style.display = 'block';

    const activeKpi = window.currentKpiFilter !== undefined && window.currentKpiFilter !== null ? window.currentKpiFilter : 'pending';
    const bar = document.querySelector('.compact-filter');
    const searchInput = bar ? bar.querySelector('input[type="search"]') : null;
    const queryVal = searchInput ? searchInput.value.trim() : '';
    const projectSelect = bar ? bar.querySelector('select') : null;
    const projectVal = projectSelect ? projectSelect.value.trim() : '';
    const activeTabBtn = document.querySelector('.task-tab-btn.active');
    const tabVal = activeTabBtn ? activeTabBtn.getAttribute('data-task-tab') : 'assigned-to-me';

    // Update browser URL query string so history.back() restores the exact filter and tab
    try {
        const currentUrl = new URL(window.location.href);
        if (activeKpi) currentUrl.searchParams.set('status', activeKpi);
        else currentUrl.searchParams.delete('status');

        if (tabVal && tabVal !== 'assigned-to-me') currentUrl.searchParams.set('task_tab', tabVal);
        else if (tabVal === 'assigned-to-me') currentUrl.searchParams.delete('task_tab');

        if (queryVal) currentUrl.searchParams.set('q', queryVal);
        else currentUrl.searchParams.delete('q');

        if (projectVal && projectVal.toLowerCase() !== 'all projects') currentUrl.searchParams.set('project', projectVal);
        else currentUrl.searchParams.delete('project');

        window.history.replaceState(null, '', currentUrl.pathname + currentUrl.search);
    } catch(e) {}

    const params = new URLSearchParams({
        page: targetPage,
        limit: 20,
        status: activeKpi,
        q: queryVal,
        project: projectVal,
        task_tab: tabVal,
        _t: Date.now()
    });

    try {
        const res = await fetch(`/tasks/api/list?${params.toString()}`, {
            signal: currentFetchController.signal,
            cache: 'no-store',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        if (!res.ok) {
            throw new Error(`HTTP ${res.status}`);
        }
        const data = await res.json();
        if (data.success) {
            currentTaskPage = targetPage;
            const container = document.querySelector('.entity-list');
            if (container) {
                if (isReset) {
                    container.querySelectorAll('.task-card').forEach(el => el.remove());
                }

                if (data.tasks && data.tasks.length > 0) {
                    data.tasks.forEach(t => {
                        const cardNode = createTaskCardNode(t);
                        container.appendChild(cardNode);
                    });
                }

                const emptyMsg = container.querySelector('.filter-empty, .empty');
                if (emptyMsg) {
                    const totalCards = container.querySelectorAll('.task-card').length;
                    emptyMsg.style.display = (totalCards === 0) ? 'block' : 'none';
                }
            }

            hasMoreTaskBatch = data.pagination ? data.pagination.hasMore : false;

            // Live update top KPI numbers if provided
            if (data.kpiCounts) {
                const totalEl = document.querySelector('.metric-card[onclick*="all"] .metric-val');
                const pendingEl = document.querySelector('.metric-card[onclick*="pending"] .metric-val');
                const progressEl = document.querySelector('.metric-card[onclick*="in progress"] .metric-val');
                const completedEl = document.querySelector('.metric-card[onclick*="completed"] .metric-val');
                const overdueEl = document.querySelector('.metric-card[onclick*="overdue"] .metric-val');
                if (totalEl && data.kpiCounts.total !== undefined) totalEl.textContent = data.kpiCounts.total;
                if (pendingEl && data.kpiCounts.pending !== undefined) pendingEl.textContent = data.kpiCounts.pending;
                if (progressEl && data.kpiCounts.progress !== undefined) progressEl.textContent = data.kpiCounts.progress;
                if (completedEl && data.kpiCounts.completed !== undefined) completedEl.textContent = data.kpiCounts.completed;
                if (overdueEl && data.kpiCounts.overdueCount !== undefined) overdueEl.textContent = data.kpiCounts.overdueCount;
            }
        }
    } catch (err) {
        if (err.name === 'AbortError') return;
        console.error('Error fetching task batch:', err);
    } finally {
        if (activeTaskFetchController === currentFetchController) {
            isLoadingTaskBatch = false;
            if (spinner) spinner.style.display = 'none';

            // Auto-fill screen if content is shorter than viewport and more pages exist
            if (hasMoreTaskBatch && document.documentElement.scrollHeight <= window.innerHeight + 150) {
                setTimeout(() => {
                    if (!isLoadingTaskBatch && hasMoreTaskBatch) {
                        fetchNextTaskBatch(false);
                    }
                }, 250);
            }
        }
    }
}
window.fetchNextTaskBatch = fetchNextTaskBatch;

window.filterTaskType = function(type, btn) {
    document.querySelectorAll('.task-tab-btn').forEach(b => {
        b.classList.remove('active');
    });
    if (btn) {
        btn.classList.add('active');
    }
    fetchNextTaskBatch(true);
};

window.filterByKpi = function(filterVal, event) {
    try {
        const valStr = String(filterVal || '').toLowerCase().trim();
        window.currentKpiFilter = valStr;

        document.querySelectorAll('.metric-card').forEach(card => {
            card.classList.remove('active-kpi-filter');
        });

        let targetCard = null;
        if (event && event.currentTarget) {
            targetCard = event.currentTarget.closest('.metric-card');
        }
        if (!targetCard) {
            document.querySelectorAll('.metric-card').forEach(card => {
                const onclickAttr = (card.getAttribute('onclick') || '').toLowerCase();
                if (onclickAttr.includes(`'${valStr}'`) || onclickAttr.includes(`"${valStr}"`)) {
                    targetCard = card;
                }
            });
        }
        if (targetCard) {
            targetCard.classList.add('active-kpi-filter');
        }
    } catch(e) {
        console.error("filterByKpi ui update error:", e);
    } finally {
        fetchNextTaskBatch(true);
    }
};

let filterTimeout = null;
document.addEventListener('input', function(e) {
    if (e.target.matches('.compact-filter input')) {
        clearTimeout(filterTimeout);
        filterTimeout = setTimeout(() => {
            fetchNextTaskBatch(true);
        }, 300);
    }
});

document.addEventListener('change', function(e) {
    if (e.target.matches('.compact-filter select')) {
        fetchNextTaskBatch(true);
    }
});

window.addEventListener('scroll', function() {
    if (isLoadingTaskBatch || !hasMoreTaskBatch) return;
    const scrollPos = window.innerHeight + window.scrollY;
    const threshold = document.documentElement.scrollHeight - 200;
    if (scrollPos >= threshold) {
        fetchNextTaskBatch(false);
    }
});

// Refetch on browser back navigation / returning from task detail page
window.addEventListener('pageshow', function(event) {
    const needsRefresh = sessionStorage.getItem('tasks_need_refresh') === '1';
    const cameFromTaskDetail = document.referrer && document.referrer.includes('/tasks/');
    if (event.persisted || needsRefresh || cameFromTaskDetail) {
        try { sessionStorage.removeItem('tasks_need_refresh'); } catch(e) {}
        fetchNextTaskBatch(true);
    }
});

document.addEventListener('visibilitychange', function() {
    if (document.visibilityState === 'visible') {
        const needsRefresh = sessionStorage.getItem('tasks_need_refresh') === '1';
        if (needsRefresh) {
            try { sessionStorage.removeItem('tasks_need_refresh'); } catch(e) {}
            fetchNextTaskBatch(true);
        }
    }
});

document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);

    // --- Restore tab & KPI state from URL on page load (e.g. after browser Back) ---
    const tabParam = params.has('task_tab') ? params.get('task_tab').trim() : 'assigned-to-me';
    const statusParam = params.has('status') ? params.get('status').trim() : 'pending';

    // Set correct tab active
    document.querySelectorAll('.task-tab-btn').forEach(b => {
        if (b.getAttribute('data-task-tab') === tabParam) b.classList.add('active');
        else b.classList.remove('active');
    });

    // Set correct KPI card active
    window.currentKpiFilter = statusParam;
    document.querySelectorAll('.metric-card').forEach(card => {
        card.classList.remove('active-kpi-filter');
        const onclickAttr = (card.getAttribute('onclick') || '').toLowerCase();
        const sl = statusParam.toLowerCase();
        // match filterByKpi('Completed') etc.
        if (
            onclickAttr.includes(`'${sl}'`) ||
            onclickAttr.includes(`"${sl}"`) ||
            (sl === 'in-progress' && onclickAttr.includes("'in progress'")) ||
            (sl === 'in progress' && onclickAttr.includes("'in progress'"))
        ) {
            card.classList.add('active-kpi-filter');
        }
    });

    // If non-default tab (assigned-by-me) or non-default status was in URL,
    // re-fetch so the tasks list matches the URL state (server renders assigned-to-me by default)
    if (tabParam !== 'assigned-to-me') {
        // Need to re-fetch with the correct tab
        fetchNextTaskBatch(true);
    }
    // If only status differs from what server rendered, server already rendered correctly,
    // no extra fetch needed.

    if (params.get('error') === 'deleted') {
        const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
        if (cancelBtn) cancelBtn.style.display = 'none';
        
        if (window.showConfirmDialog) {
            window.showConfirmDialog({
                title: 'Task Deleted',
                message: 'Task was deleted',
                confirmText: 'OK',
                danger: true
            }).then(() => {
                if (cancelBtn) cancelBtn.style.display = '';
            });
        } else {
            alert('Task was deleted');
        }
        const cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
        window.history.replaceState({path: cleanUrl}, '', cleanUrl);
    }
});
</script>


