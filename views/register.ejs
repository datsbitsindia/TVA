<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <title>Create Free Account | TVA</title>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3b68b7">
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">

    <script>
        (function() {
            var savedTheme = localStorage.getItem('tva_theme');
            document.documentElement.classList.remove('dark-theme', 'gray-glass-theme');
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark-theme');
            } else if (savedTheme === 'gray-glass') {
                document.documentElement.classList.add('gray-glass-theme');
            } else if (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark-theme');
            }
        })();
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=28">
    <link rel="stylesheet" href="/css/responsive.css?v=28">
    <link rel="stylesheet" href="/css/role-ui.css?v=28">
</head>
<body class="login-page" style="position: relative;">

    <!-- Floating Theme Picker -->
    <div style="position: fixed; top: 18px; right: 18px; z-index: 9999;">
        <div class="tva-theme-picker" style="position:relative; display:inline-block;">
            <button type="button" class="tva-theme-pill" style="display:inline-flex; align-items:center; gap:6px; padding:0 10px; height:34px; border-radius:99px; background:rgba(255,255,255,0.78); border:1.5px solid rgba(59,104,183,0.28); color:#1e293b; font-size:13px; font-weight:600; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.09); outline:none; font-family:Inter,sans-serif; white-space:nowrap;">
                <span class="tva-pill-icon" style="font-size:15px; line-height:1;">☀️</span>
                <i class="fa-solid fa-chevron-down" style="font-size:10px; color:#64748b;"></i>
            </button>
            <div class="tva-theme-popup" style="display:none; position:absolute; top:calc(100% + 8px); right:0; z-index:99999; flex-direction:column; gap:1px; min-width:172px; padding:5px; border-radius:14px; background:#fff; box-shadow:0 10px 28px rgba(15,23,42,0.16), 0 2px 6px rgba(15,23,42,0.06); border:1px solid #e2e8f0;">
                <button type="button" class="tva-theme-opt" data-theme="light" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                    <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">☀️</span>
                    <span style="flex:1;">Light Theme</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                </button>
                <button type="button" class="tva-theme-opt" data-theme="dark" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                    <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">🌙</span>
                    <span style="flex:1;">Dark Theme</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                </button>
                <button type="button" class="tva-theme-opt" data-theme="gray-glass" style="display:flex; align-items:center; gap:10px; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:13px; font-weight:500; color:#1e293b; text-align:left; font-family:Inter,sans-serif;">
                    <span style="font-size:15px; width:20px; text-align:center; flex-shrink:0;">💎</span>
                    <span style="flex:1;">Gray Glass</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none;"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="login-card" style="max-width: 440px;">
        <div class="login-icon" style="background: transparent; border: none; box-shadow: none; width: auto; height: auto; margin: 0 auto 12px; text-align: center; display: flex; justify-content: center; align-items: center;">
            <img src="/icons/tva-logo.png" alt="TVA Logo" style="max-width: 160px; width: 100%; height: auto; margin: 0 auto; display: block;">
        </div>

        <div style="display: inline-flex; align-items: center; gap: 6px; background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; font-size: 11.5px; font-weight: 700; padding: 3px 12px; border-radius: 99px; margin-bottom: 8px;">
            <i class="fa-solid fa-gift"></i> Free Forever &bull; Up to 10 Users
        </div>

        <h1 style="font-size: 22px; margin-bottom: 4px;">Create Organization</h1>
        <p style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 18px;">Start managing projects and team tasks in 30 seconds.</p>

        <% if(error){ %>
            <div class="alert error" style="margin-bottom: 16px;"><%= error %></div>
        <% } %>

        <form method="post" action="/register">
            <div style="margin-bottom: 12px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 5px;">Company / Organization Name *</label>
                <input type="text" name="orgName" value="<%= typeof orgName !== 'undefined' ? orgName : '' %>" required placeholder="e.g. Acme Corp or Team Alpha" style="width: 100%; font-weight: 400; font-size: 14px; font-family: 'Inter', sans-serif;">
            </div>

            <div style="margin-bottom: 12px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 5px;">Your Full Name (Admin) *</label>
                <input type="text" name="name" value="<%= typeof name !== 'undefined' ? name : '' %>" required placeholder="e.g. John Doe" style="width: 100%; font-weight: 400; font-size: 14px; font-family: 'Inter', sans-serif;">
            </div>

            <div style="margin-bottom: 12px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 5px;">Work Email *</label>
                <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required autocomplete="email" placeholder="you@company.com" style="width: 100%; font-weight: 400; font-size: 14px; font-family: 'Inter', sans-serif;">
            </div>

            <div style="margin-bottom: 12px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 5px;">Password (Min 4 chars) *</label>
                <input type="password" name="password" required minlength="4" placeholder="Choose a password" style="width: 100%; font-weight: 400; font-size: 14px; font-family: 'Inter', sans-serif;">
            </div>

            <div style="margin-bottom: 18px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 5px;">Phone Number (Optional)</label>
                <input type="tel" name="phone" value="<%= typeof phone !== 'undefined' ? phone : '' %>" placeholder="+91 98765 43210" style="width: 100%; font-weight: 400; font-size: 14px; font-family: 'Inter', sans-serif;">
            </div>

            <button type="submit" class="btn primary wide" style="padding: 11px; font-size: 14px; font-weight: 700;">
                <i class="fa-solid fa-rocket" style="margin-right: 6px;"></i> Create Free Workspace
            </button>
        </form>

        <p style="margin-top: 18px; font-size: 13px; color: #64748b; text-align: center;">
            Already have an account? <a href="/login" style="color: #2b579a; font-weight: 700; text-decoration: none;">Sign in</a>
        </p>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
