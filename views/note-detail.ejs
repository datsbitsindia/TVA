<%- include('partials/head', { title: (note.title || 'Untitled Note') + ' - Task Manager' }) %>
<%- include('partials/nav') %>

<style>
.note-editor-card {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 140px);
}

.note-editor-topbar {
    padding: 10px 0 !important;
    background: transparent !important;
    border-bottom: 1px solid #e2e8f0 !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 16px !important;
}

.save-status-badge {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 99px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
}

.save-status-saved {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
}

.save-status-saving {
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fde68a;
}

.save-status-error {
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
}

.note-editor-body {
    padding: 0 !important;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative !important;
}

html body input#note-title-input.note-title-field,
html body input.note-title-field,
html body .note-title-field,
.note-title-field {
    width: 100% !important;
    border: none !important;
    border-style: none !important;
    outline: none !important;
    box-shadow: none !important;
    font-size: 26px !important;
    font-weight: 700 !important;
    color: #0f172a !important;
    background: transparent !important;
    padding: 4px 42px 4px 0 !important; /* 42px right padding for vertical toolbar */
    border-radius: 0 !important;
    min-height: 0 !important;
    height: auto !important;
}

html body input#note-title-input.note-title-field:focus,
html body input.note-title-field:focus,
html body .note-title-field:focus,
.note-title-field:focus {
    border: none !important;
    border-style: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
}

/* Make CKEditor borderless and full height */
.note-editor-body .ck-editor {
    border: none !important;
    box-shadow: none !important;
}

.note-editor-body .ck.ck-editor__main>.ck-editor__editable {
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
    padding: 0 !important;
    font-size: 16px !important;
    color: #334155 !important;
    min-height: calc(100vh - 260px) !important;
    padding-bottom: 10px !important;
}

/* Formatting Toolbar inline on the top right */
.note-editor-body .ck-editor__top {
    position: absolute !important;
    top: 6px !important;
    right: 0 !important;
    z-index: 10 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: block !important;
}

.note-editor-body .ck-toolbar {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
}

.note-editor-body .ck-toolbar__items {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
}

.note-editor-body .ck.ck-button {
    font-size: 13px !important;
    padding: 4px !important;
    min-width: 28px !important;
    min-height: 28px !important;
    height: 28px !important;
    border-radius: 6px !important;
    color: #475569 !important;
    background: #f1f5f9 !important;
    border: 1px solid #e2e8f0 !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
}

.note-editor-body .ck.ck-button:hover,
.note-editor-body .ck.ck-button.ck-on {
    background: #e0e7ff !important;
    color: #4f46e5 !important;
    border-color: #c7d2fe !important;
}
</style>

<div class="note-editor-card">
    <!-- Top Action Bar -->
    <div class="note-editor-topbar">
        <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <a href="/notes" class="btn outline btn-sm" style="font-weight:700; border-radius:8px; display:inline-flex; align-items:center; gap:6px;">
                <i class="fa-solid fa-arrow-left"></i> Back to Notes
            </a>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <form action="/notes/<%= note.id %>/delete" method="post" style="margin:0;" data-confirm="Delete this note permanently?">
                <button type="submit" class="btn btn-sm" style="background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; font-size:12px; font-weight:700; border-radius:8px; padding:6px 12px;">
                    <i class="fa-solid fa-trash-can"></i> Delete Note
                </button>
            </form>
        </div>
    </div>



    <!-- Editor Body -->
    <div class="note-editor-body">
        <input 
            type="text" 
            id="note-title-input" 
            class="note-title-field" 
            value="<%= (note.title && note.title !== 'Untitled Note') ? note.title : '' %>" 
            placeholder="Enter Note Title..."
            autocomplete="off"
        >
        <textarea 
            id="note-details-input" 
            class="note-details-field ck-editor-target" 
            placeholder="Type your note details, ideas, or to-do list here..."
        ><%= note.details || '' %></textarea>
    </div>
</div>

<script>
(function() {
    const noteId = <%= note.id %>;
    const titleInput = document.getElementById('note-title-input');
    const detailsInput = document.getElementById('note-details-input');
    const statusIndicator = document.getElementById('save-status-indicator');

    let saveTimer = null;
    let hasUnsavedChanges = false;

    function setStatus(type, message) {
        // Silent auto-save in background
    }

    if (window.initCKEditor && detailsInput) {
        window.initCKEditor(detailsInput).then(editor => {
            if (editor) {
                window.noteEditor = editor;
                editor.model.document.on('change:data', scheduleAutoSave);
            }
        });
    }

    async function autoSave() {
        if (!noteId) return;
        const title = titleInput.value;
        const details = window.noteEditor ? window.noteEditor.getData() : detailsInput.value;

        setStatus('saving');

        try {
            const res = await fetch('/notes/' + noteId + '/auto-save', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ title, details })
            });
            const data = await res.json();
            if (data.success) {
                hasUnsavedChanges = false;
                const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                setStatus('saved', 'at ' + timeStr);
            } else {
                setStatus('error');
            }
        } catch (err) {
            console.error('Auto-save request failed:', err);
            setStatus('error');
        }
    }

    function scheduleAutoSave() {
        hasUnsavedChanges = true;
        setStatus('saving');
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(() => {
            autoSave();
        }, 500);
    }

    // Event Listeners for Input & Blur
    if (titleInput) {
        titleInput.addEventListener('input', scheduleAutoSave);
        titleInput.addEventListener('blur', () => {
            if (hasUnsavedChanges) autoSave();
        });
    }

    if (detailsInput) {
        detailsInput.addEventListener('input', scheduleAutoSave);
        detailsInput.addEventListener('blur', () => {
            if (hasUnsavedChanges) autoSave();
        });
    }

    // Auto-Save on Page Leave / Tab Switch
    function autoSaveOnLeave() {
        if (hasUnsavedChanges && noteId) {
            const title = titleInput.value;
            const details = window.noteEditor ? window.noteEditor.getData() : detailsInput.value;
            const payload = JSON.stringify({ title, details });

            if (navigator.sendBeacon) {
                const blob = new Blob([payload], { type: 'application/json' });
                navigator.sendBeacon('/notes/' + noteId + '/auto-save', blob);
            } else {
                fetch('/notes/' + noteId + '/auto-save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: payload,
                    keepalive: true
                });
            }
            hasUnsavedChanges = false;
        }
    }

    window.addEventListener('beforeunload', autoSaveOnLeave);
    window.addEventListener('pagehide', autoSaveOnLeave);
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') {
            autoSaveOnLeave();
        }
    });

})();
</script>

<%- include('partials/foot') %>
