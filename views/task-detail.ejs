<%- include('partials/head',{title:task.title}) %><%- include('partials/nav',{page:'task-detail'}) %>
<% if(success){ %>
    <div class="success-toast">
        <i class="fa-solid fa-circle-check"></i>
        <span><b>Update successful</b><small><%= success==='forwarded' ? 'Task has been forwarded successfully!' : (success==='status'?'Task status has been updated.':'Your update has been posted.') %></small></span>
    </div>
<% } %>

<section class="panel task-detail-card">
    <div class="task-detail-header">
        <a href="/tasks" class="back-link" style="display:inline-flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; color:#475569; text-decoration:none; margin-bottom:8px;"><i class="fa-solid fa-arrow-left"></i> Back to Tasks</a>
        <div class="task-title-group">
            <h2><%= task.title %></h2>
            <span class="project-tag" style="font-size:13px; color:#3b68b7; font-weight:600;"><i class="fa-solid fa-folder-open"></i> <%= task.project_name||'No project' %></span>
        </div>
        <div class="task-action-row">
            <% if (task.is_forwarded) { %>
                <span class="task-action-pill forwarded-pill" style="background:#e0f2fe;color:#0369a1;border-color:#bae6fd;">
                    <i class="fa-solid fa-share"></i> Forwarded
                </span>
            <% } %>
            <% const assignedIds = String(task.assigned_to || '').split(',').map(x => x.trim()); %>
            <% if (user.role !== 'admin' && (assignedIds.includes(String(user.id)) || Number(task.created_by) === Number(user.id))) { %>
                <button type="button" class="task-action-pill forward-pill" style="background:#d3e3fd;color:#0b2d68;border-color:#bae0fd;" data-open="forward-task-modal">
                    <i class="fa-solid fa-share"></i> Re-assign / Forward Task
                </button>
            <% } %>

            <% const canEditOrDelete = user.role !== 'admin' && (Number(task.created_by) === Number(user.id) || Number(task.manager_id) === Number(user.id) || assignedIds.includes(String(user.id))); %>
            <% if (canEditOrDelete) { %>
                <button type="button" class="task-action-pill edit-pill" data-open="edit-task-modal">
                    <i class="fa-solid fa-pen"></i> Edit Task
                </button>
                <form action="/tasks/<%= task.id %>/delete" method="post" data-confirm="Delete this task? Assigned user will be notified." style="margin:0;display:inline-flex;">
                    <button type="submit" class="task-action-pill delete-pill">
                        <i class="fa-solid fa-trash"></i> Delete
                    </button>
                </form>
            <% } %>

            <% 
                const isCreator = Number(task.created_by) === Number(user.id);
                const assignedUserIdsList = String(task.assigned_to || '').split(',').map(x => Number(x.trim())).filter(Boolean);
                const isAssignedToMe = assignedUserIdsList.includes(Number(user.id));
                const isAdmin = user.role === 'admin';
                const projManagerIds = String(task.manager_id || '').split(',').map(x => Number(x.trim()));
                const isProjManager = projManagerIds.includes(Number(user.id));
                const isManagerReviewer = (user.role === 'manager' || isProjManager) && !isAssignedToMe;
                const canVerify = isAdmin || isCreator || isManagerReviewer;
            %>

            <% if (task.status === 'Completed' || task.status === '2') { %>
                <% if (task.is_verified) { %>
                    <span class="task-action-pill" style="background:#dcfce7; color:#15803d; border-color:#bbf7d0; font-weight:700; cursor:default;" title="Verified by <%= task.verifier_name || 'Manager' %> <% if (task.verified_at) { %>on <%= formatDateTime(task.verified_at) %><% } %>">
                        <i class="fa-solid fa-certificate"></i> Verified by <%= task.verifier_name || 'Manager' %>
                    </span>
                    <% if (canVerify) { %>
                        <form action="/tasks/<%= task.id %>/verify" method="post" style="margin:0; display:inline-flex;">
                            <input type="hidden" name="action" value="unverify">
                            <button type="submit" class="task-action-pill" style="background:#f1f5f9; color:#475569; border-color:#cbd5e1; cursor:pointer;" title="Unverify task">
                                <i class="fa-solid fa-rotate-left"></i> Unverify
                            </button>
                        </form>
                    <% } %>
                <% } else { %>
                    <span class="task-action-pill" style="background:#fef9c3; color:#b45309; border-color:#fde68a; font-weight:700; cursor:default;" title="Waiting for <%= task.creator_name || 'Manager' %> verification">
                        <i class="fa-solid fa-triangle-exclamation"></i> Awaiting Verification
                    </span>
                    <% if (canVerify) { %>
                        <form action="/tasks/<%= task.id %>/verify" method="post" style="margin:0; display:inline-flex;">
                            <input type="hidden" name="action" value="verify">
                            <button type="submit" class="task-action-pill" style="background:#16a34a; color:#ffffff; border-color:#15803d; font-weight:700; cursor:pointer;" title="Mark task as verified">
                                <i class="fa-solid fa-user-check"></i> Mark as Verified
                            </button>
                        </form>
                    <% } %>
                <% } %>
            <% } %>
        </div>
    </div>

    <% if(task.description){ %>
        <div class="task-desc-box">
            <small style="font-size:13px; color:#000000; font-weight:700;">Task Description</small>
            <div class="task-description-content ck-content"><%- task.description %></div>
        </div>
    <% } %>

    <div class="task-info-grid">
        <div><small>Assigned By</small><b><%= task.creator_name %></b></div>
        <div><small>Assigned To</small><b><%= task.assigned_name %></b></div>
        <div><small>Due Date</small><b><%= formatDate(task.due_date) %></b></div>
        <div>
            <small>Priority</small>
            <%
              let pBg = '#f1f5f9', pText = '#475569', pBorder = '#cbd5e1';
              const pVal = (task.priority || '').toLowerCase();
              if (pVal === 'medium') {
                  pBg = '#e0f2fe'; pText = '#0369a1'; pBorder = '#bae6fd';
              } else if (pVal === 'high') {
                  pBg = '#fef3c7'; pText = '#b45309'; pBorder = '#fde68a';
              } else if (pVal === 'critical') {
                  pBg = '#fee2e2'; pText = '#b91c1c'; pBorder = '#fecaca';
              }
            %>
            <div style="margin-top: 2px;">
                <span style="display: inline-block; padding: 2px 10px; border-radius: 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; background: <%= pBg %>; color: <%= pText %>; border: 1px solid <%= pBorder %>; margin: 0 !important;">
                    <%= task.priority %>
                </span>
            </div>
        </div>
    </div>

    <% if (typeof taskAssignees !== 'undefined' && taskAssignees.length > 0) { %>
        <div class="task-team-assignees-box" style="margin-top:14px; padding:12px 14px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0;">
            <small style="font-weight:700; color:#475569; display:block; margin-bottom:8px;">Assigned Team Members (<%= taskAssignees.length %>) & Individual Status</small>
            <div style="display:flex; flex-wrap:wrap; gap:8px;">
                <% taskAssignees.forEach(a => { %>
                    <div style="display:inline-flex; align-items:center; gap:6px; background:#ffffff; border:1px solid #cbd5e1; padding:6px 12px; border-radius:99px; font-size:12px; font-weight:600;">
                        <i class="fa-solid <%= a.role === 'manager' ? 'fa-user-tie' : 'fa-user' %>" style="color:#6366f1;"></i>
                        <span><%= a.name %></span>
                        <span class="status-chip assignee-chip-user-<%= a.user_id %> <%= a.status.toLowerCase().replaceAll(' ','-') %>" data-user-id="<%= a.user_id %>" style="font-size:10px; padding:2px 8px;"><%= a.status %></span>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>


    <% if (typeof forwardLogs !== 'undefined' && forwardLogs.length > 0) { %>
        <div class="task-lineage-panel" style="margin-top:16px; padding:14px; background:#f8fafc; border-radius:12px; border:1px solid #e2e8f0;">
            <h4 style="margin:0 0 10px; font-size:13px; font-weight:700; color:#334155; display:flex; align-items:center; gap:6px;">
                <i class="fa-solid fa-timeline" style="color:#6366f1;"></i> Task Handover Lineage & Transfer History
            </h4>
            <div class="lineage-timeline" style="display:flex; flex-direction:column; gap:10px; padding-left:4px;">
                <div class="lineage-item" style="font-size:12px; color:#475569; display:flex; align-items:flex-start; gap:8px;">
                    <i class="fa-solid fa-user-check" style="color:#16a34a; margin-top:2px;"></i>
                    <div>
                        <b><%= task.creator_name %></b> (Manager) assigned task to original employee on <time style="color:#64748b;"><%= formatDateTime(task.created_at) %></time>
                    </div>
                </div>
                <% forwardLogs.forEach(f => { %>
                    <div class="lineage-item" style="font-size:12px; color:#334155; padding-left:12px; border-left:2px solid #a5b4fc; margin-left:5px;">
                        <div style="display:flex; align-items:center; gap:6px;">
                            <i class="fa-solid fa-share" style="color:#6366f1; font-size:11px;"></i>
                            <b><%= f.from_name %></b> ➔ forwarded to <b><%= f.to_name %></b>
                            <span style="color:#64748b; font-size:11px;">· <%= formatDateTime(f.created_at) %></span>
                        </div>
                        <% if (f.reason) { %>
                            <div style="margin-top:3px; background:#ffffff; padding:6px 10px; border-radius:6px; border:1px solid #cbd5e1; font-size:12px; color:#1e293b;">
                                💬 <b>Note:</b> "<%= f.reason %>"
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

    <% const isCurrentUserAssigned = String(task.assigned_to || '').split(',').includes(String(user.id)) || (typeof taskAssignees !== 'undefined' && taskAssignees.some(a => Number(a.user_id) === Number(user.id))); %>
    <% if (isCurrentUserAssigned) { %>
        <% const myAssigneeRecord = (typeof taskAssignees !== 'undefined' && taskAssignees.find(a => Number(a.user_id) === Number(user.id))) || null; %>
        <% const currentMyStatus = myAssigneeRecord ? myAssigneeRecord.status : task.status; %>
        <form action="/tasks/<%= task.id %>/status" method="post" class="status-update-form" style="margin-top:14px; display:flex; align-items:flex-end; gap:10px;">
            <label style="flex:1; margin:0;">Change My Status
                <select name="status" style="margin-top:4px;">
                    <% ['Pending','In Progress','Completed','Cancelled'].forEach(x=>{ %>
                        <option <%= currentMyStatus===x?'selected':'' %>><%= x %></option>
                    <% }) %>
                </select>
            </label>
            <button class="btn primary"><i class="fa-solid fa-check"></i> Update My Status</button>
        </form>
    <% } else { %>
        <p class="muted compact-note" style="margin-top:10px; color:#475569;">
            <i class="fa-solid fa-user-check" style="color:#6366f1;"></i> Task assigned to <b><%= task.assigned_name %></b>. Status can be updated by assigned colleagues.
        </p>
    <% } %>

</section>

<section class="panel whatsapp-chat-panel">
    <div class="chat-header">
        <i class="fa-solid fa-comments"></i>
        <h3>Updates & Discussion</h3>
        <span class="badge-count"><%= comments.length %> updates</span>
    </div>
    <div class="chat-messages-container" id="chat-messages-box">
        <% comments.forEach(c => { %>
            <div class="chat-bubble <%= c.user_id === user.id ? 'outgoing' : 'incoming' %>" data-comment-id="<%= c.id %>">
                <% if(c.user_id !== user.id){ %>
                    <span class="sender-name"><%= c.name %></span>
                <% } %>
                <p class="message-text"><%= c.message %></p>
                <div class="message-meta">
                    <time><%= formatDateTime(c.created_at) %></time>
                    <% if(c.user_id === user.id){ %>
                        <i class="fa-solid fa-check-double read-receipt"></i>
                    <% } %>
                </div>
            </div>
        <% }) %>
        <% if(!comments.length){ %>
            <p class="empty-chat">No updates posted yet. Be the first to post an update!</p>
        <% } %>
    </div>
    <form action="/tasks/<%= task.id %>/comment" method="post" class="chat-input-form">
        <textarea name="message" required placeholder="Write an update..."></textarea>
        <button class="btn primary send-btn" title="Post Update"><i class="fa-solid fa-paper-plane"></i></button>
    </form>
</section>

<!-- Forward Task Modal -->
<div class="modal" id="forward-task-modal">
    <div class="modal-card">
        <button class="modal-close" data-close>&times;</button>
        <h2><i class="fa-solid fa-share" style="color:#6366f1;"></i> Forward Task to Colleague</h2>
        <p style="color:#64748b; font-size:13px; margin-bottom:14px;">Select the colleague you want to hand over this task to and provide a handover note.</p>
        <form action="/tasks/<%= task.id %>/forward" method="post" class="form-grid">
            <label class="full">Forward To Colleague
                <select name="to_user_id" required>
                    <option value="">Select Colleague...</option>
                    <% if (typeof employees !== 'undefined' && employees.length) { %>
                        <optgroup label="Employees">
                            <% employees.filter(e => e.id !== task.assigned_to).forEach(e => { %>
                                <option value="<%= e.id %>"><%= e.name %> (<%= e.designation || 'Employee' %>)</option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                    <% if (typeof managers !== 'undefined' && managers.length) { %>
                        <optgroup label="Managers">
                            <% managers.filter(m => m.id !== task.assigned_to).forEach(m => { %>
                                <option value="<%= m.id %>"><%= m.name %> (Manager)</option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                </select>
            </label>
            <label class="full">Handover Note / Reason
                <textarea name="reason" rows="3" required placeholder="e.g. Front-end complete ho gaya hai, Backend API binding ke liye forward kar raha hu."></textarea>
            </label>
            <div class="full actions">
                <button type="button" class="btn" data-close>Cancel</button>
                <button class="btn primary"><i class="fa-solid fa-paper-plane"></i> Forward Task Now</button>
            </div>
        </form>
    </div>
</div>

<% if (typeof canEditOrDelete !== 'undefined' && canEditOrDelete) { %>
    <div class="modal" id="edit-task-modal">
        <div class="modal-card">
            <button class="modal-close" data-close>&times;</button>
            <h2>Edit Task Details</h2>
            <form action="/tasks/save" method="post" class="form-grid">
                <input type="hidden" name="id" value="<%= task.id %>">
                <label class="full">Project
                    <select name="project_id">
                        <option value="">Normal Task (No Project)</option>
                        <% (typeof projects!=='undefined'?projects:[]).forEach(p=>{ %>
                            <option value="<%= p.id %>" <%= task.project_id===p.id?'selected':'' %>><%= p.name %></option>
                        <% }) %>
                    </select>
                </label>
                <label class="full">Task title
                    <input name="title" value="<%= task.title %>" required>
                </label>
                <label class="full">Description
                    <textarea name="description" class="ck-editor-target" rows="3"><%= task.description||'' %></textarea>
                </label>
                <% if (user.role === 'manager') { %>
                <div class="full multi-assignee-picker">
                    <label>Assignees / Team Members (Select Multiple)</label>
                    <div class="assignees-chips-list" id="edit-task-assignees-list">
                        <% const currentAssigneesArr = String(task.assigned_to||'').split(',').filter(Boolean); %>
                        <% (typeof employees!=='undefined'?employees:[]).concat(typeof managers!=='undefined'?managers:[]).filter(u => currentAssigneesArr.includes(String(u.id))).forEach(u => { %>
                            <span class="assignee-chip <%= u.role==='manager'?'chip-manager':'' %>" data-assignee-id="<%= u.id %>">
                                <i class="fa-solid <%= u.role==='manager'?'fa-user-tie':'fa-user' %>"></i>
                                <span><%= u.name %></span>
                                <input type="hidden" name="assigned_to" value="<%= u.id %>">
                                <span class="chip-remove-btn" onclick="removeAssigneeChip(this)">&times;</span>
                            </span>
                        <% }) %>
                    </div>
                    <select onchange="addAssigneeChip(this, 'edit-task-assignees-list')">
                        <option value="">+ Add Employee or Manager...</option>
                        <% if (typeof employees !== 'undefined' && employees.length) { %>
                            <optgroup label="Employees">
                                <% employees.forEach(e => { %>
                                    <option value="<%= e.id %>" data-name="<%= e.name %>" data-role="Employee"><%= e.name %> (<%= e.designation || 'Employee' %>)</option>
                                <% }) %>
                            </optgroup>
                        <% } %>
                        <% if (typeof managers !== 'undefined' && managers.length) { %>
                            <optgroup label="Managers">
                                <% managers.forEach(m => { %>
                                    <option value="<%= m.id %>" data-name="<%= m.name %>" data-role="Manager"><%= m.name %> (Manager)</option>
                                <% }) %>
                            </optgroup>
                        <% } %>
                    </select>
                </div>
                <% } else { %>
                    <% String(task.assigned_to||'').split(',').filter(Boolean).forEach(uid => { %>
                        <input type="hidden" name="assigned_to" value="<%= uid %>">
                    <% }) %>
                <% } %>

                <label>Priority
                    <select name="priority">
                        <% ['Low','Medium','High','Critical'].forEach(x=>{ %>
                            <option value="<%= x %>" <%= task.priority===x?'selected':'' %>><%= x %></option>
                        <% }) %>
                    </select>
                </label>
                <label>Estimated Hours
                    <input type="number" name="estimated_hours" min="0" step="0.5" value="<%= task.estimated_hours||0 %>">
                </label>
                <label>Due Date
                    <input type="date" name="due_date" value="<%= task.due_date?new Date(task.due_date).toISOString().split('T')[0]:'' %>" required>
                </label>
                <div class="full actions">
                    <button type="button" class="btn" data-close>Cancel</button>
                    <button class="btn primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
<% } %>

<script>
window.addEventListener('DOMContentLoaded', () => {
    const box = document.getElementById('chat-messages-box');
    if(box) box.scrollTop = box.scrollHeight;

    const statusForm = document.querySelector('.status-update-form');
    if (statusForm) {
        statusForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = statusForm.querySelector('button');
            const originalBtnHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Updating...';

            try {
                const formData = new FormData(statusForm);
                const res = await fetch(statusForm.action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                const data = await res.json();
                if (data.success) {
                    const overallChip = document.querySelector('.task-info-grid .status-chip');
                    if (overallChip && data.overallStatus) {
                        overallChip.textContent = data.overallStatus;
                        overallChip.className = 'status-chip ' + data.overallStatus.toLowerCase().replaceAll(' ', '-');
                    }

                    const myUserId = '<%= user.id %>';
                    const myAssigneeChip = document.querySelector(`.assignee-chip-user-${myUserId}`);
                    if (myAssigneeChip && data.myStatus) {
                        myAssigneeChip.textContent = data.myStatus;
                        myAssigneeChip.className = `status-chip assignee-chip-user-${myUserId} ` + data.myStatus.toLowerCase().replaceAll(' ', '-');
                    }

                    if (window.showToast) {
                        const updatedStatusStr = data.myStatus || data.overallStatus || 'updated';
                        window.showToast('Update successful', `Task status updated to "${updatedStatusStr}".`, 3500);
                    }
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalBtnHtml;
                    statusForm.submit();
                }
            } catch (err) {
                console.error('Status update error:', err);
                btn.disabled = false;
                btn.innerHTML = originalBtnHtml;
                statusForm.submit();
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalBtnHtml;
            }
        });
    }

    const chatForm = document.querySelector('.chat-input-form');
    if (chatForm) {
        const textarea = chatForm.querySelector('textarea');
        if (textarea) {
            textarea.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    if (textarea.value.trim()) {
                        if (chatForm.requestSubmit) {
                            chatForm.requestSubmit();
                        } else {
                            chatForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                        }
                    }
                }
            });
        }

        chatForm.addEventListener('submit', async (e) => {

            e.preventDefault();
            const textarea = chatForm.querySelector('textarea');
            const msg = textarea.value.trim();
            if (!msg) return;

            const btn = chatForm.querySelector('.send-btn');
            btn.disabled = true;

            try {
                const formData = new FormData(chatForm);
                const res = await fetch(chatForm.action, {
                    method: 'POST',
                    body: new URLSearchParams(formData),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                const data = await res.json();
                if (data.success && data.comment) {
                    textarea.value = '';
                    const box = document.getElementById('chat-messages-box');
                    const emptyNote = box?.querySelector('.empty-chat');
                    if (emptyNote) emptyNote.remove();

                    const c = data.comment;
                    const bubble = document.createElement('div');
                    bubble.className = 'chat-bubble outgoing';
                    bubble.dataset.commentId = c.id;

                    let d = new Date(c.created_at);
                    if (isNaN(d.getTime())) d = new Date();
                    const timeStr = d.toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true });

                    bubble.innerHTML = `
                        <p class="message-text">${c.message}</p>
                        <div class="message-meta">
                            <time>${timeStr}</time>
                            <i class="fa-solid fa-check-double read-receipt"></i>
                        </div>
                    `;
                    box.appendChild(bubble);
                    box.scrollTop = box.scrollHeight;

                    const badge = document.querySelector('.badge-count');
                    if (badge) {
                        const cur = parseInt(badge.textContent || '0', 10) || 0;
                        badge.textContent = `${cur + 1} updates`;
                    }
                } else {
                    chatForm.submit();
                }
            } catch (err) {
                console.error(err);
                chatForm.submit();
            } finally {
                btn.disabled = false;
            }
        });
    }
});
</script>
<%- include('partials/task-modal') %>
<%- include('partials/foot') %>

