<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <title>Platform Super Admin | TVA Task</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --primary-gradient: linear-gradient(135deg, #2563eb, #1d4ed8);
            --bg-body: #f8fafc;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --purple: #8b5cf6;
            --radius-md: 12px;
            --radius-lg: 16px;
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: var(--bg-body); color: var(--text-dark); min-height: 100vh; display: flex; flex-direction: column; }

        /* Top Navbar */
        .sa-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }

        .sa-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: var(--text-dark);
        }

        .sa-brand-icon {
            width: 42px;
            height: 42px;
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
        }

        .sa-brand-text h1 {
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: #0f172a;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sa-domain-badge {
            font-size: 11px;
            font-weight: 600;
            background: #eff6ff;
            color: #2563eb;
            padding: 2px 8px;
            border-radius: 6px;
            border: 1px solid #bfdbfe;
        }

        .sa-brand-text p {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .sa-header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13.5px;
            font-weight: 600;
            padding: 9px 18px;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--primary-gradient);
            color: white;
            box-shadow: 0 3px 10px rgba(37, 99, 235, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.35);
        }

        .btn-outline {
            background: #ffffff;
            color: #334155;
            border: 1px solid var(--border-color);
        }

        .btn-outline:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .btn-sm { padding: 6px 12px; font-size: 12px; border-radius: 8px; }

        .sa-user-pill {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            background: #f1f5f9;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
        }

        .sa-user-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #2563eb;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        /* Container */
        .sa-container {
            max-width: 1400px;
            width: 100%;
            margin: 24px auto;
            padding: 0 24px;
            flex: 1;
        }

        /* KPI Stats Grid */
        .sa-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .sa-stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-md);
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
        }

        .sa-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .sa-stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .sa-stat-icon.blue { background: #eff6ff; color: #2563eb; }
        .sa-stat-icon.green { background: #ecfdf5; color: #10b981; }
        .sa-stat-icon.purple { background: #f5f3ff; color: #8b5cf6; }
        .sa-stat-icon.amber { background: #fffbeb; color: #f59e0b; }

        .sa-stat-info h3 {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-dark);
            line-height: 1.1;
        }

        .sa-stat-info p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
            font-weight: 500;
        }

        /* Main Table Card */
        .sa-main-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .sa-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .sa-card-title h2 {
            font-size: 18px;
            font-weight: 800;
            color: var(--text-dark);
        }

        .sa-card-title p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .sa-card-controls {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .sa-search-box {
            position: relative;
            min-width: 280px;
        }

        .sa-search-box i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
        }

        .sa-search-input {
            width: 100%;
            padding: 8px 14px 8px 36px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 13.5px;
            outline: none;
            background: #f8fafc;
            transition: all 0.2s;
        }

        .sa-search-input:focus {
            background: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        /* Table Styling */
        .sa-table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .sa-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .sa-table th {
            background: #f8fafc;
            padding: 12px 20px;
            font-size: 12px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .sa-table td {
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13.5px;
            color: #1e293b;
            vertical-align: middle;
        }

        .sa-table tr:hover td {
            background: #f8fafc;
        }

        .sa-org-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sa-org-avatar {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(37,99,235,0.25);
        }

        .sa-org-name {
            font-weight: 700;
            color: var(--text-dark);
            font-size: 14.5px;
        }

        .sa-org-meta {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .sa-admin-pill {
            display: inline-flex;
            flex-direction: column;
        }

        .sa-admin-name {
            font-weight: 600;
            color: #0f172a;
        }

        .sa-admin-email {
            font-size: 12px;
            color: var(--text-muted);
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-success { background: #dcfce7; color: #15803d; }
        .badge-warning { background: #fef3c7; color: #b45309; }
        .badge-blue { background: #dbeafe; color: #1d4ed8; }
        .badge-gray { background: #f1f5f9; color: #475569; }

        .sa-actions-cell {
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .sa-act-btn {
            background: #ffffff;
            border: 1px solid var(--border-color);
            color: #334155;
            padding: 6px 11px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.15s;
            text-decoration: none;
        }

        .sa-act-btn:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .sa-act-btn.enter {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }

        .sa-act-btn.enter:hover {
            background: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

        /* Modal Styles */
        .sa-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
        }

        .sa-modal-overlay.active {
            display: flex;
        }

        .sa-modal {
            background: #ffffff;
            border-radius: var(--radius-lg);
            width: 100%;
            max-width: 540px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
            animation: modalPop 0.2s ease-out;
        }

        .sa-modal.modal-lg {
            max-width: 800px;
        }

        @keyframes modalPop {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .sa-modal-header {
            padding: 18px 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sa-modal-header h3 {
            font-size: 17px;
            font-weight: 800;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sa-modal-close {
            background: none;
            border: none;
            color: #94a3b8;
            font-size: 18px;
            cursor: pointer;
            padding: 4px;
            border-radius: 6px;
        }

        .sa-modal-close:hover { color: #0f172a; background: #f1f5f9; }

        .sa-modal-body {
            padding: 24px;
            max-height: 75vh;
            overflow-y: auto;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12.5px;
            font-weight: 700;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border 0.15s;
        }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .sa-modal-footer {
            padding: 16px 24px;
            background: #f8fafc;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }

        /* Toast */
        .sa-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: #0f172a;
            color: white;
            padding: 12px 20px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            display: none;
            align-items: center;
            gap: 10px;
            box-shadow: var(--shadow-lg);
            z-index: 2000;
        }

        .sa-toast.show { display: flex; animation: toastSlide 0.25s ease; }
        @keyframes toastSlide { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    </style>
</head>
<body>

    <!-- Top Navigation Header -->
    <header class="sa-header">
        <a href="/superadmin" class="sa-brand">
            <div class="sa-brand-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div class="sa-brand-text">
                <h1>TVA Platform Admin <span class="sa-domain-badge">/superadmin</span></h1>
                <p>Central Multi-Tenant Organization Management</p>
            </div>
        </a>

        <div class="sa-header-actions">
            <button type="button" class="btn btn-primary" onclick="openCreateOrgModal()">
                <i class="fa-solid fa-plus"></i> Create Organization
            </button>
            <a href="/projects" class="btn btn-outline" target="_blank" title="Open Main Application">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Open TVA App
            </a>
            <div class="sa-user-pill">
                <div class="sa-user-avatar"><%= (user && user.name) ? user.name.charAt(0).toUpperCase() : 'A' %></div>
                <span><%= user ? user.name : 'Super Admin' %></span>
            </div>
            <a href="/superadmin/logout" class="btn btn-outline btn-sm" title="Logout">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
            </a>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="sa-container">

        <!-- 4 KPI Metrics -->
        <section class="sa-stats-grid">
            <div class="sa-stat-card">
                <div class="sa-stat-icon blue">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div class="sa-stat-info">
                    <h3 id="stat-orgs"><%= stats.totalOrgs %></h3>
                    <p>Total Organizations</p>
                </div>
            </div>

            <div class="sa-stat-card">
                <div class="sa-stat-icon purple">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div class="sa-stat-info">
                    <h3 id="stat-users"><%= stats.totalUsers %></h3>
                    <p>Total Users (All Orgs)</p>
                </div>
            </div>

            <div class="sa-stat-card">
                <div class="sa-stat-icon green">
                    <i class="fa-solid fa-diagram-project"></i>
                </div>
                <div class="sa-stat-info">
                    <h3 id="stat-projects"><%= stats.totalProjects %></h3>
                    <p>Active Projects</p>
                </div>
            </div>

            <div class="sa-stat-card">
                <div class="sa-stat-icon amber">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div class="sa-stat-info">
                    <h3 id="stat-tasks"><%= stats.totalTasks %></h3>
                    <p>Tasks (<%= stats.completedTasks %> completed)</p>
                </div>
            </div>
        </section>

        <!-- Main Organizations Table Card -->
        <section class="sa-main-card">
            <div class="sa-card-header">
                <div class="sa-card-title">
                    <h2>Organizations Directory</h2>
                    <p>Manage all client companies, primary admins, and switch workspaces in 1 click.</p>
                </div>

                <div class="sa-card-controls">
                    <div class="sa-search-box">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="org-search" class="sa-search-input" placeholder="Search by Org or Admin email..." onkeyup="filterOrgs()">
                    </div>
                </div>
            </div>

            <div class="sa-table-responsive">
                <table class="sa-table" id="orgs-table">
                    <thead>
                        <tr>
                            <th style="width: 50px;">ID</th>
                            <th>Organization</th>
                            <th>Primary Administrator</th>
                            <th>Members</th>
                            <th>Projects & Tasks</th>
                            <th>Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="orgs-tbody">
                        <% if (orgs && orgs.length > 0) { %>
                            <% orgs.forEach(org => { %>
                                <tr id="org-row-<%= org.id %>" data-org-name="<%= org.name.toLowerCase() %>" data-admin-email="<%= (org.admin?.email || '').toLowerCase() %>" data-admin-name="<%= (org.admin?.name || '').toLowerCase() %>">
                                    <td style="color: var(--text-muted); font-weight: 700;">#<%= org.id %></td>
                                    <td>
                                        <div class="sa-org-cell">
                                            <div class="sa-org-avatar"><%= org.name.charAt(0).toUpperCase() %></div>
                                            <div>
                                                <div class="sa-org-name"><%= org.name %></div>
                                                <div class="sa-org-meta">Created: <%= new Date(org.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="sa-admin-pill">
                                            <span class="sa-admin-name"><i class="fa-solid fa-user-shield" style="color: #3b82f6; margin-right: 4px; font-size: 11px;"></i> <%= org.admin?.name || 'N/A' %></span>
                                            <span class="sa-admin-email"><%= org.admin?.email || 'N/A' %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <button type="button" class="badge badge-blue" onclick="openOrgUsersModal(<%= org.id %>, '<%= org.name %>')" style="cursor: pointer; border: none;" title="Click to view all users">
                                            <i class="fa-solid fa-users"></i> <%= org.user_count %> Users
                                        </button>
                                    </td>
                                    <td>
                                        <div style="font-size: 13px;">
                                            <strong><%= org.project_count %></strong> Projects • <strong><%= org.task_count %></strong> Tasks
                                        </div>
                                    </td>
                                    <td>
                                        <% if (org.active) { %>
                                            <span class="badge badge-success"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Active</span>
                                        <% } else { %>
                                            <span class="badge badge-gray"><i class="fa-solid fa-circle" style="font-size: 6px;"></i> Inactive</span>
                                        <% } %>
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="sa-actions-cell" style="justify-content: flex-end;">
                                            <a href="/superadmin/switch-org/<%= org.id %>" class="sa-act-btn enter" title="Impersonate and enter this organization workspace">
                                                <i class="fa-solid fa-arrow-right-to-bracket"></i> Enter Org
                                            </a>
                                            <button type="button" class="sa-act-btn" onclick="openOrgUsersModal(<%= org.id %>, '<%= org.name %>')" title="Manage users">
                                                <i class="fa-solid fa-user-gear"></i> Users
                                            </button>
                                            <button type="button" class="sa-act-btn" onclick="openEditOrgModal(<%= org.id %>, '<%= org.name %>', <%= org.active ? 1 : 0 %>)" title="Edit Org details">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                                    <i class="fa-solid fa-building" style="font-size: 32px; margin-bottom: 8px; opacity: 0.4;"></i>
                                    <p>No organizations found. Click "Create Organization" to add one.</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <!-- Modal 1: Create New Organization -->
    <div id="modal-create-org" class="sa-modal-overlay">
        <div class="sa-modal">
            <div class="sa-modal-header">
                <h3><i class="fa-solid fa-building-circle-plus" style="color: #2563eb;"></i> Create New Organization</h3>
                <button type="button" class="sa-modal-close" onclick="closeModal('modal-create-org')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="create-org-form" onsubmit="handleCreateOrg(event)">
                <div class="sa-modal-body">
                    <div class="form-group">
                        <label class="form-label">Organization / Company Name *</label>
                        <input type="text" id="new-org-name" class="form-control" placeholder="e.g. Acme Technologies" required>
                    </div>

                    <div style="background: #f1f5f9; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;">
                        <span style="font-size: 12px; font-weight: 700; color: #334155; text-transform: uppercase; letter-spacing: 0.5px;">Initial Admin Account</span>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Admin Full Name *</label>
                            <input type="text" id="new-admin-name" class="form-control" placeholder="e.g. Rahul Sharma" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Admin Phone</label>
                            <input type="text" id="new-admin-phone" class="form-control" placeholder="e.g. 9876543210">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Admin Email *</label>
                            <input type="email" id="new-admin-email" class="form-control" placeholder="admin@company.com" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Admin Password *</label>
                            <input type="password" id="new-admin-pass" class="form-control" placeholder="Min 4 characters" minlength="4" required>
                        </div>
                    </div>
                </div>

                <div class="sa-modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('modal-create-org')">Cancel</button>
                    <button type="submit" id="btn-submit-org" class="btn btn-primary">
                        <i class="fa-solid fa-check"></i> Create Organization
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal 2: Edit Organization -->
    <div id="modal-edit-org" class="sa-modal-overlay">
        <div class="sa-modal">
            <div class="sa-modal-header">
                <h3><i class="fa-solid fa-pen-to-square" style="color: #2563eb;"></i> Edit Organization</h3>
                <button type="button" class="sa-modal-close" onclick="closeModal('modal-edit-org')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="edit-org-form" onsubmit="handleEditOrg(event)">
                <input type="hidden" id="edit-org-id">
                <div class="sa-modal-body">
                    <div class="form-group">
                        <label class="form-label">Organization Name *</label>
                        <input type="text" id="edit-org-name" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select id="edit-org-active" class="form-control">
                            <option value="1">Active</option>
                            <option value="0">Inactive / Suspended</option>
                        </select>
                    </div>
                </div>

                <div class="sa-modal-footer">
                    <button type="button" class="btn btn-outline" onclick="closeModal('modal-edit-org')">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal 3: Manage Organization Users (Slide/Large modal) -->
    <div id="modal-org-users" class="sa-modal-overlay">
        <div class="sa-modal modal-lg">
            <div class="sa-modal-header">
                <h3><i class="fa-solid fa-users" style="color: #2563eb;"></i> <span id="users-modal-title">Organization Users</span></h3>
                <button type="button" class="sa-modal-close" onclick="closeModal('modal-org-users')"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="sa-modal-body">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <p style="font-size: 13px; color: var(--text-muted);">Manage member accounts, reset passwords, or add new staff.</p>
                    <button type="button" class="btn btn-primary btn-sm" onclick="toggleAddUserForm()">
                        <i class="fa-solid fa-user-plus"></i> Add User
                    </button>
                </div>

                <!-- Inline Add User Form (Hidden by default) -->
                <form id="add-user-inline-form" onsubmit="handleAddOrgUser(event)" style="display: none; background: #f8fafc; border: 1px solid var(--border-color); border-radius: 10px; padding: 16px; margin-bottom: 18px;">
                    <h4 style="font-size: 14px; font-weight: 700; margin-bottom: 12px; color: #1e293b;">Add New Member</h4>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Full Name *</label>
                            <input type="text" id="new-user-name" class="form-control" placeholder="Name" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Address *</label>
                            <input type="email" id="new-user-email" class="form-control" placeholder="email@company.com" required>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Password *</label>
                            <input type="password" id="new-user-pass" class="form-control" placeholder="Min 4 chars" minlength="4" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Role *</label>
                            <select id="new-user-role" class="form-control">
                                <option value="employee">Employee</option>
                                <option value="manager">Manager</option>
                                <option value="admin">Administrator</option>
                            </select>
                        </div>
                    </div>
                    <div style="display: flex; justify-content: flex-end; gap: 8px;">
                        <button type="button" class="btn btn-outline btn-sm" onclick="toggleAddUserForm()">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-check"></i> Save User</button>
                    </div>
                </form>

                <!-- Users List Table -->
                <div class="sa-table-responsive" style="max-height: 400px;">
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th>Name & Email</th>
                                <th>Role</th>
                                <th>Department</th>
                                <th>Status</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="org-users-tbody">
                            <tr><td colspan="5" style="text-align: center; padding: 20px;">Loading users...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="sa-modal-footer">
                <button type="button" class="btn btn-outline" onclick="closeModal('modal-org-users')">Close</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="sa-toast" class="sa-toast">
        <i class="fa-solid fa-circle-check" style="color: #10b981;"></i>
        <span id="sa-toast-msg">Success</span>
    </div>

    <script>
        let currentViewingOrgId = null;

        function showToast(msg, isError = false) {
            const toast = document.getElementById('sa-toast');
            const toastMsg = document.getElementById('sa-toast-msg');
            toastMsg.innerText = msg;
            toast.querySelector('i').className = isError ? 'fa-solid fa-triangle-exclamation' : 'fa-solid fa-circle-check';
            toast.querySelector('i').style.color = isError ? '#ef4444' : '#10b981';
            toast.classList.add('show');
            setTimeout(() => { toast.classList.remove('show'); }, 3500);
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function openCreateOrgModal() {
            document.getElementById('create-org-form').reset();
            document.getElementById('modal-create-org').classList.add('active');
            setTimeout(() => document.getElementById('new-org-name').focus(), 100);
        }

        function openEditOrgModal(id, name, active) {
            document.getElementById('edit-org-id').value = id;
            document.getElementById('edit-org-name').value = name;
            document.getElementById('edit-org-active').value = String(active);
            document.getElementById('modal-edit-org').classList.add('active');
        }

        async function handleCreateOrg(e) {
            e.preventDefault();
            const btn = document.getElementById('btn-submit-org');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Creating...`;

            const payload = {
                orgName: document.getElementById('new-org-name').value.trim(),
                adminName: document.getElementById('new-admin-name').value.trim(),
                adminPhone: document.getElementById('new-admin-phone').value.trim(),
                adminEmail: document.getElementById('new-admin-email').value.trim(),
                adminPassword: document.getElementById('new-admin-pass').value.trim()
            };

            try {
                const res = await fetch('/superadmin/api/organizations', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-check"></i> Create Organization`;

                if (data.success) {
                    closeModal('modal-create-org');
                    showToast(data.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-check"></i> Create Organization`;
                alert('Request failed: ' + err.message);
            }
        }

        async function handleEditOrg(e) {
            e.preventDefault();
            const orgId = document.getElementById('edit-org-id').value;
            const payload = {
                name: document.getElementById('edit-org-name').value.trim(),
                active: Number(document.getElementById('edit-org-active').value)
            };

            try {
                const res = await fetch(`/superadmin/api/organizations/${orgId}/update`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    closeModal('modal-edit-org');
                    showToast('Organization updated successfully.');
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }

        async function openOrgUsersModal(orgId, orgName) {
            currentViewingOrgId = orgId;
            document.getElementById('users-modal-title').innerText = `${orgName} — Members`;
            document.getElementById('modal-org-users').classList.add('active');
            document.getElementById('add-user-inline-form').style.display = 'none';
            document.getElementById('org-users-tbody').innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 20px;"><i class="fa-solid fa-spinner fa-spin"></i> Loading users...</td></tr>`;

            try {
                const res = await fetch(`/superadmin/api/organizations/${orgId}/users`);
                const data = await res.json();
                if (data.success && data.users) {
                    renderUsersTable(data.users);
                } else {
                    document.getElementById('org-users-tbody').innerHTML = `<tr><td colspan="5" style="text-align: center; color: red;">Failed to load users.</td></tr>`;
                }
            } catch (err) {
                document.getElementById('org-users-tbody').innerHTML = `<tr><td colspan="5" style="text-align: center; color: red;">Error: ${err.message}</td></tr>`;
            }
        }

        function renderUsersTable(users) {
            const tbody = document.getElementById('org-users-tbody');
            if (users.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-muted);">No users in this organization.</td></tr>`;
                return;
            }

            tbody.innerHTML = users.map(u => `
                <tr>
                    <td>
                        <strong style="color: #0f172a;">${u.name}</strong>
                        <div style="font-size: 12px; color: var(--text-muted);">${u.email} ${u.phone ? '• ' + u.phone : ''}</div>
                    </td>
                    <td>
                        <span class="badge ${u.role === 'admin' ? 'badge-blue' : u.role === 'manager' ? 'badge-warning' : 'badge-gray'}">
                            ${u.role.toUpperCase()}
                        </span>
                    </td>
                    <td style="font-size: 13px;">${u.department || '-'}</td>
                    <td>
                        <span class="badge ${u.active ? 'badge-success' : 'badge-gray'}">
                            ${u.active ? 'Active' : 'Inactive'}
                        </span>
                    </td>
                    <td style="text-align: right;">
                        <button class="sa-act-btn btn-sm" onclick="promptResetPassword(${u.id}, '${u.name}')" title="Reset Password">
                            <i class="fa-solid fa-key"></i> Password
                        </button>
                        <button class="sa-act-btn btn-sm" onclick="toggleUser(${u.id})" title="Toggle Active">
                            <i class="fa-solid fa-power-off"></i>
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function toggleAddUserForm() {
            const form = document.getElementById('add-user-inline-form');
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        async function handleAddOrgUser(e) {
            e.preventDefault();
            if (!currentViewingOrgId) return;

            const payload = {
                name: document.getElementById('new-user-name').value.trim(),
                email: document.getElementById('new-user-email').value.trim(),
                password: document.getElementById('new-user-pass').value.trim(),
                role: document.getElementById('new-user-role').value
            };

            try {
                const res = await fetch(`/superadmin/api/organizations/${currentViewingOrgId}/users`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message);
                    document.getElementById('add-user-inline-form').reset();
                    toggleAddUserForm();
                    // Refresh users
                    const usersRes = await fetch(`/superadmin/api/organizations/${currentViewingOrgId}/users`);
                    const usersData = await usersRes.json();
                    if (usersData.success) renderUsersTable(usersData.users);
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }

        async function promptResetPassword(userId, userName) {
            const newPass = prompt(`Enter new password for ${userName}:`);
            if (!newPass || newPass.trim().length < 4) {
                if (newPass !== null) alert('Password must be at least 4 characters.');
                return;
            }

            try {
                const res = await fetch(`/superadmin/api/users/${userId}/reset-password`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newPassword: newPass.trim() })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(`Password updated for ${userName}!`);
                } else {
                    alert('Error: ' + data.message);
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            }
        }

        async function toggleUser(userId) {
            try {
                const res = await fetch(`/superadmin/api/users/${userId}/toggle`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message);
                    // Refresh current org users table
                    if (currentViewingOrgId) {
                        const usersRes = await fetch(`/superadmin/api/organizations/${currentViewingOrgId}/users`);
                        const usersData = await usersRes.json();
                        if (usersData.success) renderUsersTable(usersData.users);
                    }
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }

        function filterOrgs() {
            const query = document.getElementById('org-search').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#orgs-tbody tr');

            rows.forEach(row => {
                const orgName = row.getAttribute('data-org-name') || '';
                const adminEmail = row.getAttribute('data-admin-email') || '';
                const adminName = row.getAttribute('data-admin-name') || '';

                if (orgName.includes(query) || adminEmail.includes(query) || adminName.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
