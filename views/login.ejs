<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover">
    <title>Login | TVA</title>

    <!-- PWA Settings -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#3b68b7">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="TVA">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">

    <script>
        (function() {
            var savedTheme = localStorage.getItem('tva_theme');
            document.documentElement.classList.remove('dark-theme', 'gray-glass-theme');
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark-theme');
            } else if (savedTheme === 'gray-glass') {
                document.documentElement.classList.add('gray-glass-theme');
            } else if (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark-theme');
            }
        })();
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=28">
    <link rel="stylesheet" href="/css/responsive.css?v=28">
    <link rel="stylesheet" href="/css/role-ui.css?v=28">
</head>
<body class="login-page" style="position: relative;">

    <!-- Floating Theme Picker -->
    <div style="position: fixed; top: 18px; right: 18px; z-index: 9999;">
        <div class="tva-theme-picker" style="position:relative; display:inline-block;">
            <button type="button" class="tva-theme-pill" style="display:inline-flex; align-items:center; justify-content:center; padding:0 10px; height:34px; border-radius:99px; background:rgba(255,255,255,0.78); border:1.5px solid rgba(59,104,183,0.28); color:#1e293b; font-size:18px; cursor:pointer; box-shadow:0 2px 8px rgba(15,23,42,0.09); outline:none; white-space:nowrap;">
                <span class="tva-pill-icon" style="font-size:18px; line-height:1;">☀️</span>
            </button>
            <div class="tva-theme-popup" style="display:none; position:absolute; top:calc(100% + 8px); right:0; z-index:99999; flex-direction:column; gap:1px; min-width:70px; padding:5px; border-radius:14px; background:#fff; box-shadow:0 10px 28px rgba(15,23,42,0.16), 0 2px 6px rgba(15,23,42,0.06); border:1px solid #e2e8f0;">
                <button type="button" class="tva-theme-opt" data-theme="light" style="display:flex; align-items:center; justify-content:center; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:20px; position:relative;">
                    <span>☀️</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%);"></i>
                </button>
                <button type="button" class="tva-theme-opt" data-theme="dark" style="display:flex; align-items:center; justify-content:center; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:20px; position:relative;">
                    <span>🌙</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%);"></i>
                </button>
                <button type="button" class="tva-theme-opt" data-theme="gray-glass" style="display:flex; align-items:center; justify-content:center; width:100%; padding:9px 11px; border:none; background:transparent; border-radius:9px; cursor:pointer; font-size:20px; position:relative;">
                    <span>💎</span>
                    <i class="fa-solid fa-check tva-opt-tick" style="font-size:11px; color:#3b68b7; display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%);"></i>
                </button>
            </div>
        </div>

    </div>


    <div class="login-card">
        <div class="login-icon" style="background: transparent; border: none; box-shadow: none; width: auto; height: auto; margin: 0 auto 16px; text-align: center; display: flex; justify-content: center; align-items: center;">
            <img src="/icons/tva-logo.png" alt="TVA Logo" style="max-width: 180px; width: 100%; height: auto; margin: 0 auto; display: block;">
        </div>
        <h1>Welcome back</h1>
        <p>Sign in to manage your work.</p>

        <button id="pwa-install-btn" class="btn primary wide" style="display:none; margin-bottom: 14px; background:#2b579a; font-weight:700;">
            <i class="fa-solid fa-download"></i> Install App on Mobile
        </button>

        <% if(error){ %>
            <div class="alert error"><%= error %></div>
        <% } %>

        <form method="post" action="/login">
            <div style="margin-bottom: 14px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 6px;">Email</label>
                <input type="email" name="email" required autocomplete="email" placeholder="you@gmail.com" style="font-weight: 400; font-size: 14px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            </div>
            <div style="margin-bottom: 18px; text-align: left;">
                <label style="display: block; font-weight: 700; font-size: 13px; margin-bottom: 6px;">Password</label>
                <input type="password" name="password" required autocomplete="current-password" placeholder="Your password" style="font-weight: 400; font-size: 14px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            </div>
            <button class="btn primary wide">Sign in</button>
        </form>

    </div>

    <script src="/js/app.js"></script>
</body>
</html>
